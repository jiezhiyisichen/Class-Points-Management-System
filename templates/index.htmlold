	    async function adminAdjustScore() {
	        if (!currentUser) return showToast('请先登录', 'warning');
	        const id = document.getElementById('adminAdjId').value.trim();
	        const posAdj = parseInt(document.getElementById('adminAdjPos').value) || 0;
	        const negAdj = parseInt(document.getElementById('adminAdjNeg').value) || 0;
	
	        const stu = students.find(s => s.id === id);
	        if (!stu) return showToast('学号不存在', 'error');
	
	        const newPos = Math.max(0, stu.positive_score + posAdj);
	        const newNeg = Math.max(0, stu.negative_score + negAdj);
	
	        try {
	            // 先删除原学生
	            let res = await fetch(`/api/students/${id}?username=${currentUser.username}`, {
	                method: 'DELETE'
	            });
	            if (!res.ok) {
	                const data = await res.json();
	                showToast(data.msg || '删除失败', 'error');
	                return;
	            }
	            // 再添加新学生
	            res = await fetch('/api/students', {
	                method: 'POST',
	                headers: { 'Content-Type': 'application/json' },
	                body: JSON.stringify({
	                    username: currentUser.username,
	                    id: stu.id,
	                    name: stu.name,
	                    positive_score: newPos,
	                    negative_score: newNeg
	                })
	            });
	            const data = await res.json();
	            if (data.success) {
	                showToast('调整成功');
	                await loadUserData(currentUser.username);
	                refreshAll();
	                addLog('INFO', 'Admin Adjust Score', `${id} pos:${posAdj} neg:${negAdj} -> new(${newPos},${newNeg})`);
	            } else {
	                showToast(data.msg, 'error');
	            }
	        } catch (err) {
	            showToast('网络错误', 'error');
	        }
	    }
	
	    // ==================== 辅助函数 ====================
	    // 显示随机学生
		function showRandomStudent() {
		    if (!students || students.length === 0) {
		        document.getElementById('randomStudentContent').innerHTML = '<p class="text-center py-4 text-gray-500">暂无学生数据</p>';
		    } else {
		        const randomIndex = Math.floor(Math.random() * students.length);
		        const student = students[randomIndex];
		        document.getElementById('randomStudentContent').innerHTML = `
		            <div class="space-y-3">
		                <p><span class="font-bold">姓名：</span>${student.name}</p>
		                <p><span class="font-bold">学号：</span>${student.id}</p>
		                <p><span class="font-bold">正分：</span>${student.positive_score}</p>
		                <p><span class="font-bold">负分：</span>${student.negative_score}</p>
		                <p><span class="font-bold">总分：</span>${student.total_score}</p>
		            </div>
		        `;
		    }
		    openModal('randomStudentModal');
		}
	    function addNote() {
	        if (!currentUser) return showToast('请先登录', 'warning');
	        if (checkLocked('添加注释')) return;
	        const studentId = document.getElementById('noteStudentId').value.trim();
	        const content = document.getElementById('noteContent').value.trim();
	        if (!studentId || !content) {
	            showToast('学号和内容不能为空', 'warning');
	            return;
	        }
	        if (!students.find(s => s.id === studentId)) {
	            showToast('学号不存在', 'error');
	            return;
	        }
	        if (!studentNotes[studentId]) {
	            studentNotes[studentId] = [];
	        }
	        // 自动编号（取最大 id + 1）
	        const maxId = studentNotes[studentId].reduce((max, n) => Math.max(max, n.id), 0);
	        const newId = maxId + 1;
	        studentNotes[studentId].push({ id: newId, content });
	        saveNotes();
	        closeAllModals();
	        showToast('注释添加成功');
	        addLog('INFO', 'Add Note', `Added note for ${studentId}: ${content}`);
	    }
	    
	    function deleteNote() {
	        if (!currentUser) return showToast('请先登录', 'warning');
	        if (checkLocked('删除注释')) return;
	        const studentId = document.getElementById('delNoteStudentId').value.trim();
	        const noteId = parseInt(document.getElementById('delNoteNumber').value);
	        if (!studentId || !noteId) {
	            showToast('学号和编号不能为空', 'warning');
	            return;
	        }
	        // 检查学生是否存在
	        if (!students.find(s => s.id === studentId)) {
	            showToast('学生不存在', 'error');
	            return;
	        }
	        if (!studentNotes[studentId]) {
	            showToast('该学生暂无注释', 'error');
	            return;
	        }
	        const index = studentNotes[studentId].findIndex(n => n.id === noteId);
	        if (index === -1) {
	            showToast('注释编号不存在', 'error');
	            return;
	        }
	        studentNotes[studentId].splice(index, 1);
	        saveNotes();
	        closeAllModals();
	        showToast('注释删除成功');
	        addLog('WARN', 'Delete Note', `Deleted note ${noteId} for ${studentId}`);
	    }
	
	    function openGenericModal(title, callback) {
	        document.getElementById('genericModalTitle').innerText = title;
	        const modal = document.getElementById('genericPasswordModal');
	        modal.classList.remove('hidden');
	        setTimeout(() => modal.classList.remove('opacity-0'), 10);
	
	        const confirmBtn = document.getElementById('genericConfirmBtn');
	        const handler = (e) => {
	            const pwd = document.getElementById('genericPassword').value;
	            callback(pwd);
	            document.getElementById('genericPassword').value = '';
	            closeAllModals();
	            confirmBtn.removeEventListener('click', handler);
	        };
	        confirmBtn.addEventListener('click', handler, { once: true });
	    }
	
	    function openPointsModal(type) {
	        const modal = document.getElementById('pointsActionModal');
	        const title = document.getElementById('pointsActionTitle');
	        const extra = document.getElementById('extraPosNeg');
	        const pointsGroup = document.getElementById('pointsInputGroup');
	    
	        title.innerText = type === 'pay' ? '支付 (从正分扣除)' : '添加积分 (正/负)';
	        if (type === 'pay') {
	            extra.classList.add('hidden');
	            pointsGroup.classList.remove('hidden');
	        } else {
	            extra.classList.remove('hidden');
	            pointsGroup.classList.add('hidden');
	        }
	    
	        modal.classList.remove('hidden');
	        setTimeout(() => modal.classList.remove('opacity-0'), 10);
	
	        // 移除旧监听，重新绑定
	        const confirmBtn = document.getElementById('confirmPointsAction');
	        const newHandler = async (e) => {
	            if (!currentUser) return showToast('请先登录', 'warning');
	            const id = document.getElementById('actionStudentId').value.trim();
	            if (!id) { showToast('请输入学号', 'warning'); return; }
	
	            try {
	                if (type === 'pay') {
	                    const points = parseInt(document.getElementById('actionPoints').value) || 0;
	                    if (points <= 0) return showToast('输入有效分数', 'warning');
	                    const res = await fetch(`/api/students/${id}/adjust-score`, {
	                        method: 'POST',
	                        headers: { 'Content-Type': 'application/json' },
	                        body: JSON.stringify({
	                            username: currentUser.username,
	                            operation: 'reduce',
	                            positive_adjust: points,
	                            negative_adjust: 0
	                        })
	                    });
	                    const data = await res.json();
	                    if (data.success) {
	                        showToast('支付成功');
	                        await loadUserData(currentUser.username);
	                        refreshAll();
	                        addLog('INFO', 'Payment', `${id} paid ${points} points`);
	                    } else {
	                        showToast(data.msg, 'error');
	                    }
	                } else { // add
	                    const posAdd = parseInt(document.getElementById('actionPos').value) || 0;
	                    const negAdd = parseInt(document.getElementById('actionNeg').value) || 0;
	                    if (posAdd === 0 && negAdd === 0) return showToast('至少填一个', 'warning');
	                    const res = await fetch(`/api/students/${id}/adjust-score`, {
	                        method: 'POST',
	                        headers: { 'Content-Type': 'application/json' },
	                        body: JSON.stringify({
	                            username: currentUser.username,
	                            operation: 'add',
	                            positive_adjust: posAdd,
	                            negative_adjust: negAdd
	                        })
	                    });
	                    const data = await res.json();
	                    if (data.success) {
	                        showToast('添加成功');
	                        await loadUserData(currentUser.username);
	                        refreshAll();
	                        addLog('INFO', 'Add Points', `${id} +pos:${posAdd} +neg:${negAdd}`);
	                    } else {
	                        showToast(data.msg, 'error');
	                    }
	                }
	                closeAllModals();
	            } catch (err) {
	                showToast('网络错误', 'error');
	            }
	        };
	
	        // 移除之前绑定的监听器（如果有），再绑定新监听器
	        confirmBtn.replaceWith(confirmBtn.cloneNode(true));
	        document.getElementById('confirmPointsAction').addEventListener('click', newHandler);
	    }
	
	    function resetSettingsPanel() {
	        document.getElementById('settingsPasswordWrap').classList.remove('hidden');
	        document.getElementById('settingsContent').classList.add('hidden');
	    }
	
	    function exportLogs() {
	        const dataStr = JSON.stringify(logs, null, 2);
	        const blob = new Blob([dataStr], { type: 'application/json' });
	        const url = URL.createObjectURL(blob);
	        const a = document.createElement('a');
	        a.href = url;
	        a.download = `logs_${Date.now()}.json`;
	        a.click();
	        addLog('INFO', 'Export Logs', `Exported ${logs.length} entries`);
	    }
	
	    async function loadUserList() {
	        if (!currentUser || currentUser.role !== 'admin') return;
	    
	        try {
	            const res = await fetch(`/api/admin/users?adminUsername=${currentUser.username}`);
	            const data = await res.json();
	    
	            if (data.success) {
	                const tbody = document.getElementById('userListBody');
	                tbody.innerHTML = '';
	    
	                data.data.forEach(u => {
	                    const passwordMask = '●'.repeat(u.password_length || 8);
	                    const row = document.createElement('tr');
	                    row.className = 'border-b hover:bg-gray-50';
	                    // 判断当前登录用户是否为 ysc
						const isYsc = currentUser.username === 'ysc';
						
						row.innerHTML = `
						    <td class="px-4 py-2">${u.username}</td>
						    <td class="px-4 py-2">${u.created_at || '未知'}</td>
						    <td class="px-4 py-2">${u.role}</td>
						    <td class="px-4 py-2 font-mono">${passwordMask}</td>
						    <td class="px-4 py-2 space-x-2">
						        ${isYsc && u.username !== 'ysc' && u.role !== 'admin' ? `<button class="text-xs bg-green-500 text-white px-2 py-1 rounded make-admin" data-user="${u.username}">设为管理员</button>` : ''}
						        <button class="text-xs bg-blue-500 text-white px-2 py-1 rounded reset-pwd" data-user="${u.username}">重置密码</button>
						        ${u.username !== 'ysc' ? `<button class="text-xs bg-red-500 text-white px-2 py-1 rounded delete-user" data-user="${u.username}">删除</button>` : '<span class="text-xs text-gray-400">不可删除</span>'}
						    </td>
						`;
	                    tbody.appendChild(row);
	                });
	    
	                // 绑定重置密码事件
	                document.querySelectorAll('.reset-pwd').forEach(btn => {
	                    btn.addEventListener('click', async (e) => {
	                        e.stopPropagation();
	                        const targetUser = e.target.dataset.user;
	                        if (!confirm(`确定重置用户 ${targetUser} 的密码为 123456 吗？`)) return;
	    
	                        try {
	                            const res = await fetch(`/api/admin/users/${targetUser}/reset-password`, {
	                                method: 'POST',
	                                headers: { 'Content-Type': 'application/json' },
	                                body: JSON.stringify({ adminUsername: currentUser.username })
	                            });
	                            const result = await res.json();
	                            if (result.success) {
	                                showToast('密码已重置为 123456');
	                                addLog('INFO', 'Admin Reset Password', `Reset password for ${targetUser}`);
	                                loadUserList();
	                            } else {
	                                showToast(result.msg, 'error');
	                            }
	                        } catch (err) {
	                            showToast('网络错误', 'error');
	                        }
	                    });
	                });
	    
	                // 绑定删除用户事件
	                document.querySelectorAll('.delete-user').forEach(btn => {
	                    btn.addEventListener('click', async (e) => {
	                        e.stopPropagation();
	                        const targetUser = e.target.dataset.user;
	                        if (targetUser === currentUser.username) {
	                            showToast('不能删除自己', 'warning');
	                            return;
	                        }
	                        if (!confirm(`确定删除用户 ${targetUser} 吗？此操作不可恢复。`)) return;
	    
	                        try {
	                            const res = await fetch(`/api/admin/users/${targetUser}?adminUsername=${currentUser.username}`, {
	                                method: 'DELETE'
	                            });
	                            const result = await res.json();
	                            if (result.success) {
	                                showToast('用户已删除');
	                                addLog('WARN', 'Admin Delete User', `Deleted user ${targetUser}`);
	                                loadUserList();
	                            } else {
	                                showToast(result.msg, 'error');
	                            }
	                        } catch (err) {
	                            showToast('网络错误', 'error');
	                        }
	                    });
	                });
	                // 设为管理员事件
					document.querySelectorAll('.make-admin').forEach(btn => {
					    btn.addEventListener('click', async (e) => {
					        e.stopPropagation();
					        const targetUser = e.target.dataset.user;
					        if (!confirm(`确定将 ${targetUser} 设为管理员吗？`)) return;
					        try {
					            const res = await fetch('/api/admin/make-admin', {
					                method: 'POST',
					                headers: { 'Content-Type': 'application/json' },
					                credentials: 'include',
					                body: JSON.stringify({ adminUsername: currentUser.username, targetUser })
					            });
					            const result = await res.json();
					            if (result.success) {
					                showToast(`${targetUser} 已成为管理员`);
					                loadUserList(); // 刷新列表
					            } else {
					                showToast(result.msg, 'error');
					            }
					        } catch (err) {
					            showToast('网络错误', 'error');
					        }
					    });
					});
	            } else {
	                showToast(data.msg, 'error');
	            }
	        } catch (err) {
	            showToast('网络错误', 'error');
	        }
	    }
	
	    function searchStudent() {
	        const searchId = document.getElementById('searchInput').value.trim();
	        if (!searchId) {
	            showToast('请输入学号', 'warning');
	            return;
	        }
	
	        const student = students.find(s => s.id === searchId);
	        const resultContent = document.getElementById('searchResultContent');
	
	        if (student) {
	            resultContent.innerHTML = `
	                <div class="space-y-4">
	                    <div class="flex justify-between border-b pb-2">
	                        <span class="text-gray-600">学号：</span>
	                        <span class="font-medium">${student.id}</span>
	                    </div>
	                    <div class="flex justify-between border-b pb-2">
	                        <span class="text-gray-600">姓名：</span>
	                        <span class="font-medium">${student.name}</span>
	                    </div>
	                    <div class="flex justify-between border-b pb-2">
	                        <span class="text-gray-600">正分：</span>
	                        <span class="text-green-600 font-medium">${student.positive_score}</span>
	                    </div>
	                    <div class="flex justify-between border-b pb-2">
	                        <span class="text-gray-600">负分：</span>
	                        <span class="text-red-600 font-medium">${student.negative_score}</span>
	                    </div>
	                    <div class="flex justify-between border-b pb-2">
	                        <span class="text-gray-600 font-medium">总分：</span>
	                        <span class="${student.total_score >= 0 ? 'text-blue-600' : 'text-red-600'} font-bold text-lg">${student.total_score}</span>
	                    </div>
	                </div>
	            `;
	            addLog('INFO', 'Search Student', `Searched ${searchId} (${student.name})`);
	        } else {
	            resultContent.innerHTML = `
	                <div class="text-center py-8 text-gray-500">
	                    <i class="fa fa-exclamation-circle text-2xl mb-2"></i>
	                    <p>未找到学号为 ${searchId} 的学生</p>
	                </div>
	            `;
	            addLog('WARN', 'Search Student', `Student ${searchId} not found`);
	        }
	
	        openModal('searchResultModal');
	    }
		function homeSearchStudent() {
			console.log('homeSearchStudent called, students length:', students.length); 
		    const searchId = document.getElementById('homeSearchInput').value.trim();
		    if (!searchId) {
		        showToast('请输入学号', 'warning');
		        return;
		    }
		    const student = students.find(s => s.id === searchId);
		    const resultContent = document.getElementById('searchResultContent');
		    if (student) {
		        resultContent.innerHTML = `
		            <div class="space-y-4">
		                <div class="flex justify-between border-b pb-2"><span class="text-gray-600">学号：</span><span class="font-medium">${student.id}</span></div>
		                <div class="flex justify-between border-b pb-2"><span class="text-gray-600">姓名：</span><span class="font-medium">${student.name}</span></div>
		                <div class="flex justify-between border-b pb-2"><span class="text-gray-600">正分：</span><span class="text-green-600 font-medium">${student.positive_score}</span></div>
		                <div class="flex justify-between border-b pb-2"><span class="text-gray-600">负分：</span><span class="text-red-600 font-medium">${student.negative_score}</span></div>
		                <div class="flex justify-between border-b pb-2"><span class="text-gray-600 font-medium">总分：</span><span class="${student.total_score >= 0 ? 'text-blue-600' : 'text-red-600'} font-bold text-lg">${student.total_score}</span></div>
		            </div>
		        `;
		        addLog('INFO', 'Search Student', `Searched ${searchId} (${student.name})`);
		    } else {
		        resultContent.innerHTML = `<div class="text-center py-8 text-gray-500"><i class="fa fa-exclamation-circle text-2xl mb-2"></i><p>未找到学号为 ${searchId} 的学生</p></div>`;
		        addLog('WARN', 'Search Student', `Student ${searchId} not found`);
		    }
		    openModal('searchResultModal');
		}
	    function verifyPasswordOld() {
	        if (!currentUser) {
	            showToast('请先登录', 'warning');
	            return;
	        }
	        const password = document.getElementById('password').value.trim();
	        if (verifyPassword(password)) {
	            closeAllModals();
	            openModal('scoreAdjustModal');
	        } else {
	            showToast('密码错误', 'error');
	        }
	    }
	
	    // ==================== 事件监听初始化 ====================
	    function initAllEventListeners() {
	        // 选项卡切换
	        document.querySelectorAll('#tabNav button').forEach(btn => {
	            btn.addEventListener('click', function () {
	                document.querySelectorAll('#tabNav button').forEach(b => {
	                    b.classList.remove('tab-active');
	                    b.classList.add('tab-inactive');
	                });
	                this.classList.add('tab-active');
	                this.classList.remove('tab-inactive');
	        
	                document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
	                const target = this.dataset.tab;
	                addLog('INFO', 'Tab Switch', `Switched to ${target}`);
	                document.getElementById(target).classList.remove('hidden');
	        
	                if (target === 'log-tab') renderLogTable();
	                if (target === 'settings-tab') resetSettingsPanel();
	            });
	        });
	
	        // 添加注释按钮
	        // 随机学生按钮
	        document.getElementById('randomButton').addEventListener('click', showRandomStudent);
	        document.getElementById('addNoteBtn').addEventListener('click', () => {
	            if (checkLocked('添加注释')) return;
	            document.getElementById('noteStudentId').value = '';
	            document.getElementById('noteContent').value = '';
	            openModal('addNoteModal');
	        });
	
	        document.getElementById('deleteNoteBtn').addEventListener('click', () => {
	            if (checkLocked('删除注释')) return;
	            document.getElementById('delNoteStudentId').value = '';
	            document.getElementById('delNoteNumber').value = '';
	            openModal('deleteNoteModal');
	        });
	
	        // 确认添加注释
	        document.getElementById('confirmAddNote').addEventListener('click', addNote);
	        // 确认删除注释
	        document.getElementById('confirmDeleteNote').addEventListener('click', deleteNote);
	
	        // document.getElementById('searchBtn').addEventListener('click', searchStudent);
	        // document.getElementById('searchInput').addEventListener('keypress', function (e) {
	            // if (e.key === 'Enter') searchStudent();
	        // });
	        const homeSearchBtn = document.getElementById('homeSearchBtn');
			if (homeSearchBtn) {
			    homeSearchBtn.addEventListener('click', homeSearchStudent);
			} else {
			    console.error('homeSearchBtn not found!');
			}
			
			const homeSearchInput = document.getElementById('homeSearchInput');
			if (homeSearchInput) {
			    homeSearchInput.addEventListener('keypress', function(e) {
			        if (e.key === 'Enter') homeSearchStudent();
			    });
			} else {
			    console.error('homeSearchInput not found!');
			}
	
	        // 锁定/解锁
	        document.getElementById('unlockBtn').addEventListener('click', () => {
	            if (!currentUser) return showToast('请先登录', 'warning');
	            if (!isLocked) { showToast('已经是解锁状态', 'info'); return; }
	            openGenericModal('解锁验证', (pwd) => {
	                if (pwd.includes(classInfo.password)) {
	                    isLocked = false;
	                    localStorage.setItem(`locked_${currentUser.username}`, 'false');
	                    updateLockUI();
	                    addLog('INFO', 'Unlock', 'System unlocked');
	                    showToast('已解锁');
	                    closeAllModals();
	                } else {
	                    addLog('ERROR', 'Password Error', 'Unlock failed: incorrect password');
	                    showToast('密码错误', 'error');
	                }
	            });
	        });
	
	        document.getElementById('lockBtn').addEventListener('click', () => {
	            if (!currentUser) return showToast('请先登录', 'warning');
	            if (isLocked) return showToast('已经是锁定状态', 'info');
	            isLocked = true;
	            localStorage.setItem(`locked_${currentUser.username}`, 'true');
	            updateLockUI();
	            addLog('INFO', 'Lock', 'System locked');
	            showToast('已锁定');
	        });
	
	        // 支付/添加积分
	        document.getElementById('payBtn').addEventListener('click', () => {
	            addLog('INFO', 'Button Click', 'Opened payment modal');
	            if (checkLocked('支付')) return;
	            openPointsModal('pay');
	        });
	
	        document.getElementById('addPointsBtn').addEventListener('click', () => {
	            addLog('INFO', 'Button Click', 'Opened add points modal');
	            if (checkLocked('添加积分')) return;
	            openPointsModal('add');
	        });
	
	        // 导出日志
	        document.getElementById('exportLogsBtn').addEventListener('click', exportLogs);
			document.getElementById('clearLogsBtn').addEventListener('click', () => {
			    if (!currentUser) {
			        showToast('请先登录', 'warning');
			        return;
			    }
			    if (confirm('确定清空所有日志吗？')) {
			        logs = [];
			        localStorage.setItem(`logs_${currentUser.username}`, JSON.stringify(logs));
			        renderLogTable();
			        showToast('日志已清空');
			        addLog('INFO', 'Clear Logs', 'All logs cleared');
			    }
			});
			document.getElementById('exportDataBtn').addEventListener('click', () => {
			    if (!currentUser) {
			        showToast('请先登录', 'warning');
			        return;
			    }
			    if (students.length === 0) {
			        showToast('没有学生数据可导出', 'info');
			        return;
			    }
			    // 构建包含学生和注释的完整数据包
			    const exportData = {
			        students: students,
			        notes: studentNotes   // 注释对象
			    };
			    const dataStr = JSON.stringify(exportData, null, 2);
			    const blob = new Blob([dataStr], { type: 'application/json' });
			    const url = URL.createObjectURL(blob);
			    const a = document.createElement('a');
			    a.href = url;
			    a.download = `${classInfo.className || 'students'}_${new Date().toISOString().slice(0,10)}.json`;
			    a.click();
			    URL.revokeObjectURL(url);
			    addLog('INFO', 'Export Data', `Exported ${students.length} students with notes`);
			});
			document.getElementById('importDataBtn').addEventListener('click', () => {
			    if (!currentUser) {
			        showToast('请先登录', 'warning');
			        return;
			    }
			    document.getElementById('importFileInput').click();
			});
			
			document.getElementById('importFileInput').addEventListener('change', async function (e) {
			    const file = e.target.files[0];
			    if (!file) return;
			
			    const reader = new FileReader();
			    reader.onload = async (event) => {
			        try {
			            const importedData = JSON.parse(event.target.result);
			            let importedStudents = [];
			            let importedNotes = {};
			
			            if (Array.isArray(importedData)) {
			                importedStudents = importedData;
			                importedNotes = {};
			                showToast('检测到旧格式数据，注释将清空', 'info');
			            } else if (importedData && Array.isArray(importedData.students)) {
			                importedStudents = importedData.students;
			                importedNotes = importedData.notes || {};
			            } else {
			                showToast('导入文件格式错误：应为学生数组或包含students字段的对象', 'error');
			                return;
			            }
			
			            if (importedStudents.length === 0) {
			                showToast('文件中没有学生数据', 'warning');
			                return;
			            }
			
			            if (!confirm(`确定导入 ${importedStudents.length} 名学生？此操作将覆盖当前所有学生数据和注释。`)) {
			                return;
			            }
			
			            // 显示持久化进度 toast
			            showToast('准备导入...', 'info', 0);
			
			            // 1. 删除当前所有学生（后端）
			            const deleteTotal = students.length;
			            let deletedCount = 0;
			            for (const s of students) {
			                try {
			                    await fetch(`/api/students/${s.id}?username=${currentUser.username}`, {
			                        method: 'DELETE'
			                    });
			                } catch (err) {
			                    console.error('删除失败', s.id, err);
			                }
			                deletedCount++;
			                const percent = Math.round((deletedCount / deleteTotal) * 100);
			                showToast(`正在删除旧数据：${percent}% (${deletedCount}/${deleteTotal})`, 'info', 0);
			            }
			
			            // 2. 逐个添加导入的学生
			            const addTotal = importedStudents.length;
			            let addedCount = 0;
			            for (const s of importedStudents) {
			                const student = {
			                    id: String(s.id || s.studentId || ''),
			                    name: s.name || '',
			                    positive_score: s.positive_score || s.positiveScore || 0,
			                    negative_score: s.negative_score || s.negativeScore || 0
			                };
			                if (!student.id || !student.name) {
			                    console.warn('跳过无效学生数据', s);
			                    continue;
			                }
			                try {
			                    await fetch('/api/students', {
			                        method: 'POST',
			                        headers: { 'Content-Type': 'application/json' },
			                        body: JSON.stringify({
			                            username: currentUser.username,
			                            id: student.id,
			                            name: student.name,
			                            positive_score: student.positive_score,
			                            negative_score: student.negative_score
			                        })
			                    });
			                } catch (err) {
			                    console.error('添加失败', student.id, err);
			                }
			                addedCount++;
			                const percent = Math.round((addedCount / addTotal) * 100);
			                showToast(`正在导入：${percent}% (${addedCount}/${addTotal})`, 'info', 0);
			            }
			
			            // 3. 恢复注释数据
			            studentNotes = importedNotes;
			            saveNotes();
			
			            // 4. 重新加载数据
			            await loadUserData(currentUser.username);
			            refreshAll();
			
			            // 关闭进度 toast
			            closeProgressToast();
			            showToast('导入完成！', 'success');
			
			            addLog('INFO', 'Import Data', `Imported ${importedStudents.length} students with notes`);
			
			        } catch (err) {
			            closeProgressToast();  // 确保错误时关闭
			            showToast('导入失败：' + err.message, 'error');
			        }
			    };
			    reader.readAsText(file);
			    e.target.value = '';
			});
	        // 关于按钮
	        document.getElementById('aboutButton').addEventListener('click', () => {
	            document.getElementById('aboutModal').classList.remove('hidden');
	            setTimeout(() => document.getElementById('aboutModal').classList.remove('opacity-0'), 10);
	        });
	
	        document.getElementById('closeAbout').addEventListener('click', () => {
	            document.getElementById('aboutModal').classList.add('opacity-0');
	            setTimeout(() => document.getElementById('aboutModal').classList.add('hidden'), 300);
	        });
	
	        // 设置页相关
	        document.getElementById('verifySettingsBtn').addEventListener('click', () => {
	            const pwd = document.getElementById('settingsPasswordInput').value;
	            if (pwd.includes(classInfo.password)) {
	                document.getElementById('settingsPasswordWrap').classList.add('hidden');
	                document.getElementById('settingsContent').classList.remove('hidden');
	                document.getElementById('settingUsername').value = classInfo.username;
	                document.getElementById('settingClassName').value = classInfo.className;
	                document.getElementById('settingAnnouncementPreview').value = classInfo.announcement || '';
	                addLog('INFO', 'Settings Access', 'Entered settings page');
	        
	                // 根据角色显示管理员面板
	                const adminPanel = document.getElementById('adminPanel');
	                if (currentUser && currentUser.role === 'admin') {
	                    adminPanel.classList.remove('hidden');
	                    loadUserList();
	                } else {
	                    adminPanel.classList.add('hidden');
	                }
	            } else {
	                addLog('ERROR', 'Password Error', 'Settings access failed: incorrect password');
	                showToast('密码错误', 'error');
	            }
	        });
	            
	        document.getElementById('updateAccountBtn').addEventListener('click', async () => {
			    const newU = document.getElementById('settingUsername').value.trim();
			    const newC = document.getElementById('settingClassName').value.trim();
			    // 获取新密码（原注释被错误地包含了，这里分开写）
				const newP = document.getElementById('settingNewPwd').value;
				const conf = document.getElementById('settingConfirmPwd').value;
			
			    // 更新用户名和班级名（前端本地）
			    if (newU) classInfo.username = newU;
			    if (newC) classInfo.className = newC;
			    // if (newAnnouncement !== undefined) classInfo.announcement = newAnnouncement; // 更新本地对象// 如果新密码不为空，则尝试修改密码
			    if (newP || conf) {
			        if (newP !== conf) { showToast('密码不一致', 'error'); return; }
			        if (newP.length > 0) {
			            try {
			                const res = await fetch('/api/change-password', {
			                    method: 'POST',
			                    headers: { 'Content-Type': 'application/json' },
			                    body: JSON.stringify({
			                        username: currentUser.username,
			                        old_password: classInfo.password,
			                        new_password: newP
			                    })
			                });
			                const data = await res.json();
			                if (data.success) {
			                    classInfo.password = newP;
			                    localStorage.setItem(`password_${currentUser.username}`, newP);
			                    showToast('密码修改成功');
			                } else {
			                    showToast(data.msg, 'error');
			                    return;
			                }
			            } catch (err) {
			                showToast('网络错误', 'error');
			                return;
			            }
			        }
			    }
			
			    // 更新班级信息到后端（包含公告）
			    try {
			        const res = await fetch('/api/class-info', {
					    method: 'POST',
					    headers: { 'Content-Type': 'application/json' },
					    credentials: 'include',   // 新增
					    body: JSON.stringify({
					        username: currentUser.username,
					        className: classInfo.className,
					        announcement: classInfo.announcement
					    })
					});
			        const data = await res.json();
			        if (data.success) {
			            localStorage.setItem(`classInfo_${currentUser.username}`, JSON.stringify(classInfo));
			            showToast('账户信息已更新');
			            addLog('INFO', 'Account Update', `Username:${newU}, Class:${newC}, Announcement updated`);
			            document.getElementById('classNameDisplay').innerText = classInfo.className;
			        } else {
			            showToast(data.msg, 'error');
			        }
			    } catch (err) {
			        showToast('网络错误', 'error');
			    }
			});
	
	        // 管理员操作（设置页）
	        document.getElementById('adminAddStudent').addEventListener('click', adminAddStudent);
	        document.getElementById('adminDelBtn').addEventListener('click', adminDeleteStudent);
	        document.getElementById('adminAdjBtn').addEventListener('click', adminAdjustScore);
	
	        // 表单提交
	        document.getElementById('addStudentForm').addEventListener('submit', function (e) {
	            e.preventDefault();
	            addStudent();
	        });
	
	        document.getElementById('deleteStudentForm').addEventListener('submit', function (e) {
	            e.preventDefault();
	            deleteStudent();
	        });
	
	        document.getElementById('passwordForm').addEventListener('submit', function (e) {
	            e.preventDefault();
	            verifyPasswordOld();
	        });
	
	        document.getElementById('scoreAdjustForm').addEventListener('submit', function (e) {
	            e.preventDefault();
	            adjustScore();
	        });
	
	        // 登录
	        document.getElementById('loginSubmitBtn').addEventListener('click', async () => {
	            const username = document.getElementById('loginUsername').value.trim();
	            const password = document.getElementById('loginPassword').value.trim();
	            if (!username || !password) return showToast('请输入用户名和密码', 'warning');
	
	            try {
	                const res = await fetch('/api/login', {
	                    method: 'POST',
	                    headers: { 'Content-Type': 'application/json' },
	                    body: JSON.stringify({ username, password })
	                });
	                const data = await res.json();
	                if (data.success) {
	                    currentUser = { 
	                        username: data.data.username, 
	                        role: data.data.role 
	                    };
	                    sessionStorage.setItem('currentUser', JSON.stringify(currentUser));
	                    localStorage.setItem(`password_${username}`, password);
	                    await loadUserData(username);
	                    refreshAll();
	                    closeAllModals();
	                    showToast('登录成功');
	                    addLog('INFO', 'Login', `User ${username} logged in`);
	                } else {
	                    showToast(data.msg, 'error');
	                }
	            } catch (err) {
	                showToast('网络错误', 'error');
	            }
	        });
	
	        // 注册
	        document.getElementById('registerSubmitBtn').addEventListener('click', async () => {
	            const username = document.getElementById('regUsername').value.trim();
	            const password = document.getElementById('regPassword').value.trim();
	            if (!username || !password) return showToast('用户名和密码不能为空', 'warning');
	
	            try {
	                const res = await fetch('/api/register', {
	                    method: 'POST',
	                    headers: { 'Content-Type': 'application/json' },
	                    body: JSON.stringify({ username, password })
	                });
	                const data = await res.json();
	                if (data.success) {
	                    const defaultClass = { className: '🏫 银河一班', username, password };
	                    localStorage.setItem(`classInfo_${username}`, JSON.stringify(defaultClass));
	                    localStorage.setItem(`password_${username}`, password);
	                    localStorage.setItem(`locked_${username}`, 'true');
	                    showToast('注册成功，请登录');
	                    closeAllModals();
	                    openModal('loginModal');
	                } else {
	                    showToast(data.msg, 'error');
	                }
	            } catch (err) {
	                showToast('网络错误', 'error');
	            }
	        });
	
	        // 退出登录
	        document.getElementById('logoutBtn').addEventListener('click', () => {
	            if (confirm('确定要退出登录吗？')) {
	                currentUser = null;
	                sessionStorage.removeItem('currentUser');
	                students = [];
	                refreshAll();
	                showToast('已退出登录');
	                addLog('INFO', 'Logout', 'User logged out');
	            }
	        });
	
	        // 通用关闭模态框
	        document.querySelectorAll('.close-modal').forEach(btn => {
	            btn.addEventListener('click', closeAllModals);
	        });
	
	        document.querySelectorAll('.modal-backdrop').forEach(modal => {
	            modal.addEventListener('click', function (e) {
	                if (e.target === this) closeAllModals();
	            });
	        });
	
	        // 打开登录/注册模态框
	        document.getElementById('loginBtn').addEventListener('click', () => openModal('loginModal'));
	        document.getElementById('registerBtn').addEventListener('click', () => openModal('registerModal'));
	        document.getElementById('clearAllScoresBtn').addEventListener('click', () => {
			    if (!currentUser) {
			        showToast('请先登录', 'warning');
			        return;
			    }
			    openGenericModal('清除所有学生积分 - 输入当前账号密码', async (pwd) => {
			        if (!confirm('此操作将把所有学生的正分、负分、总分重置为0，但等级保持不变。是否继续？')) {
			            return;
			        }
			        try {
			            const res = await fetch('/api/admin/clear-all-scores', {
			                method: 'POST',
			                headers: { 'Content-Type': 'application/json' },
			                credentials: 'include',
			                body: JSON.stringify({
			                    username: currentUser.username,
			                    password: pwd
			                })
			            });
			            const data = await res.json();
			            if (data.success) {
			                showToast('积分已清零');
			                await loadUserData(currentUser.username);
			                refreshAll();
			            } else {
			                showToast(data.msg, 'error');
			            }
			        } catch (err) {
			            showToast('网络错误', 'error');
			        }
			    });
			});
			// 右下角 📢 按钮：只读模式
			document.getElementById('globalAnnouncementBtn').addEventListener('click', () => {
			    globalAnnouncementMode = 'view';
			    loadGlobalAnnouncement().then(() => {
			        setupGlobalAnnouncementModal('view');
			        openModal('globalAnnouncementModal');
			    });
			});
			
			// 设置页中的“编辑全局公告”按钮：编辑模式
			document.getElementById('editGlobalAnnouncementFromSettings').addEventListener('click', () => {
			    globalAnnouncementMode = 'edit';
			    loadGlobalAnnouncement().then(() => {
			        setupGlobalAnnouncementModal('edit');
			        openModal('globalAnnouncementModal');
			        // 自动进入编辑状态（如果有权限）
			        if (currentUser && (currentUser.username === 'ysc' || currentUser.role === 'admin')) {
			            setTimeout(() => {
			                const editBtn = document.getElementById('editGlobalAnnouncementBtn');
			                if (editBtn && !editBtn.classList.contains('hidden')) {
			                    editBtn.click();
			                }
			            }, 300);
			        }
			    });
			});
	    }
	
	    // ==================== 登录状态检查 ====================
	    async function checkLoginStatus() {
	        const savedUser = sessionStorage.getItem('currentUser');
	        if (savedUser) {
	            const parsed = JSON.parse(savedUser);
	            currentUser = parsed;
	            await loadUserData(currentUser.username);
	            refreshAll();
	            showToast(`欢迎回来，${currentUser.username}`);
	        } else {
	            currentUser = null;
	            students = [];
	            refreshAll();
	        }
	    }
	
	    // ==================== 启动 ====================
	    document.addEventListener('DOMContentLoaded', async function () {
	        await checkLoginStatus();
	        initAllEventListeners();
	    });
	</script>
</body>
</html>