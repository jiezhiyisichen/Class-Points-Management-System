<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Class Score</title>
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">

    <!-- ========== 本地资源 ========== -->
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/tailwind.min.css') }}">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/font-awesome.min.css') }}">
    <!-- Chart.js -->
    <script src="{{ url_for('static', filename='js/chart.umd.min.js') }}"></script>
	<!-- Markdown 解析库 -->
	<script src="{{ url_for('static', filename='js/marked.min.js') }}"></script>

    
    <!-- 合并的样式（原版工具类 + 重构版自定义样式） -->
    
    <!-- 重构版自定义样式 + 原版隐形窗口修复样式 -->
    <style>
		#rollingStudentCard {
		    transition: transform 1s ease-in-out, opacity 1s ease-in-out;
		}
		#scoreCardCarousel {
		    transition: opacity 0.4s ease-in-out;
		    opacity: 1;
		}
        /* 原版：隐形窗口遮挡修复 */
        .modal-backdrop.opacity-0 {
            pointer-events: none;
        }
        .modal-backdrop:not(.opacity-0) {
            pointer-events: auto;
        }
        
        /* 重构版：自定义滚动条及杂项 */
        .scrollable-x {
		    overflow-x: auto;
		    overflow-y: hidden;
		    white-space: nowrap;
		    -webkit-overflow-scrolling: touch;
		    scrollbar-width: thin;
		    max-width: 100%;          /* 确保不超过父容器 */
		    width: 100%;
		    min-height: 260px;        /* 给滚动条留出空间 */
		    border: 1px solid #e5e7eb; /* 可选，便于观察边界 */
		}
        .scrollable-x canvas {
            display: inline-block;
            width: auto;
            height: 100%;
        }
        .log-table tr {
            transition: background-color 0.2s;
        }
        .log-table tr:hover {
            background-color: #f3f4f6;
        }
        .tooltip-cell {
            position: relative;
            cursor: help;
        }
        .tooltip-cell:hover::after {
            content: attr(data-full);
            position: absolute;
            background: #1e293b;
            color: white;
            font-size: 0.75rem;
            padding: 4px 8px;
            border-radius: 4px;
            bottom: 100%;
            left: 0;
            white-space: pre-wrap;
            z-index: 60;
            min-width: 200px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.3);
        }
        /* 锁定状态遮罩指示 */
        .locked-overlay {
            opacity: 0.7;
            pointer-events: none;
        }
        .i-button {
        	z-index: 99999999 !important;
		    position: relative !important; 
		    width: 48px;
		    height: 48px;
		    border-radius: 9999px;
		    background: #3b82f6;
		    color: white;
		    display: flex;
		    align-items: center;
		    justify-content: center;
		    font-size: 24px;
		    font-weight: bold;
		    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);
		    cursor: pointer;
		    transition: transform 0.2s;
		    position: relative;   /* 新增 */
		    z-index: 1;           /* 新增 */
		}
        .i-button:hover {
            transform: scale(1.1);
            background: #2563eb;
        }
        .about-card {
            background: linear-gradient(145deg, #ffffff, #f0f4ff);
            border: 1px solid #cbd5e1;
        }
        /* 自定义颜色类 */
	    .bg-primary { background-color: #3b82f6; }
	    .bg-secondary { background-color: #64748b; }
	    .bg-success { background-color: #22c55e; }
	    .bg-danger { background-color: #ef4444; }
	    .bg-warning { background-color: #f59e0b; }
	    .bg-info { background-color: #0ea5e9; }
	    .text-primary { color: #3b82f6; }
	    .text-secondary { color: #64748b; }
	    .text-success { color: #22c55e; }
	    .text-danger { color: #ef4444; }
	    .text-warning { color: #f59e0b; }
	    .text-info { color: #0ea5e9; }
	    .border-primary { border-color: #3b82f6; }
	    /* ===== 按钮基础样式 ===== */
		.btn-primary, .btn-secondary, .btn-success, .btn-danger, .btn-warning, .btn-info {
		    display: inline-block;
		    font-weight: 400;
		    text-align: center;
		    white-space: nowrap;
		    vertical-align: middle;
		    user-select: none;
		    border: 1px solid transparent;
		    padding: 0.5rem 1rem;        /* 对应 px-4 py-2 */
		    font-size: 1rem;
		    line-height: 1.5;
		    border-radius: 0.375rem;      /* 对应 rounded-md (0.375rem) */
		    transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
		}
		
		/* 各按钮颜色（使用之前定义的颜色类） */
		.btn-primary {
		    background-color: #3b82f6;    /* bg-primary */
		    color: white;
		}
		.btn-primary:hover {
		    background-color: #2563eb;     /* hover:bg-blue-600 */
		}
		
		.btn-secondary {
		    background-color: #64748b;    /* bg-secondary */
		    color: white;
		}
		.btn-secondary:hover {
		    background-color: #475569;     /* hover:bg-slate-600 */
		}
		
		.btn-success {
		    background-color: #22c55e;    /* bg-success */
		    color: white;
		}
		.btn-success:hover {
		    background-color: #16a34a;     /* hover:bg-green-600 */
		}
		
		.btn-danger {
		    background-color: #ef4444;    /* bg-danger */
		    color: white;
		}
		.btn-danger:hover {
		    background-color: #dc2626;     /* hover:bg-red-600 */
		}
		
		.btn-warning {
		    background-color: #f59e0b;    /* bg-warning */
		    color: white;
		}
		.btn-warning:hover {
		    background-color: #d97706;     /* hover:bg-amber-600 */
		}
		
		.btn-info {
		    background-color: #0ea5e9;    /* bg-info */
		    color: white;
		}
		.btn-info:hover {
		    background-color: #0284c7;     /* hover:bg-blue-500 (与原信息按钮一致) */
		}
		
		/* 为按钮添加 focus 样式（可选） */
		.btn-primary:focus, .btn-secondary:focus, .btn-success:focus, .btn-danger:focus, .btn-warning:focus, .btn-info:focus {
		    outline: none;
		    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5); /* 蓝色 focus ring */
		}
		/* 卡片悬停效果 */
		.card-hover {
		    transition: all 0.3s;
		}
		.card-hover:hover {
		    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
		    transform: scale(1.02);
		}
		
		/* 输入框样式 */
		.input-field {
		    width: 100%;
		    padding: 0.5rem 1rem;
		    border: 1px solid #d1d5db; /* border-gray-300 */
		    border-radius: 0.375rem;
		    outline: none;
		    transition: all 0.3s;
		}
		.input-field:focus {
		    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5); /* 模拟 focus:ring-2 ring-primary */
		    border-color: transparent;
		}
		
		/* 标签页样式 */
		.tab-active {
		    border-bottom: 2px solid #3b82f6; /* border-primary */
		    color: #3b82f6; /* text-primary */
		}
		.tab-inactive {
		    color: #6b7280; /* text-gray-500 */
		}
		.tab-inactive:hover {
		    color: #374151; /* text-gray-700 */
		}
		
		/* 如果需要，可以补充正负分颜色（如果 Tailwind 默认未包含） */
		.text-green-600 { color: #16a34a; }
		.text-red-600 { color: #dc2626; }
		.border-green-400 { border-color: #4ade80; }
		.border-red-400 { border-color: #f87171; }
		/* 补充缺失的 Tailwind 工具类 */
		.fixed {
		    position: fixed;
		}
		.inset-0 {
		    top: 0;
		    right: 0;
		    bottom: 0;
		    left: 0;
		}
		/* 模态框背景色（使用 rgba 直接定义，避免依赖 bg-opacity） */
		.modal-backdrop {
		    background-color: rgba(0, 0, 0, 0.5);
		}
		/* 如果还有透明度控制类 */
		.opacity-0 {
		    opacity: 0;
		}
		.opacity-100 {
		    opacity: 1;
		}
		/* 确保模态框内容居中（您的样式已有） */
		.modal-content {
		    background-color: white;
		    border-radius: 0.5rem;
		    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
		    max-width: 28rem; /* max-w-md */
		    width: 100%;
		    margin: 0 1rem;
		}
		.modal-backdrop {
		    position: fixed;
		    top: 0;
		    left: 0;
		    right: 0;
		    bottom: 0;
		    background-color: rgba(0, 0, 0, 0.5);
		    display: flex;
		    align-items: center;
		    justify-content: center;
		    z-index: 50;
		    transition: opacity 0.3s;
		}
		/* 强制按钮容器及按钮本身位于最顶层 */
		#buttonContainer {
		    z-index: 99999999 !important;
		    position: fixed !important;
		    bottom: 1.5rem !important;   /* 对应 bottom-6 */
		    right: 1.5rem !important;    /* 对应 right-6 */
		    display: flex !important;
		    flex-direction: row !important;
		    gap: 0.75rem !important;     /* 对应 gap-3 */
		}
		/* 全局公告模态框滚动修复 */
		#globalAnnouncementModal .modal-content {
		    max-height: 90vh;
		    display: flex;
		    flex-direction: column;
		    overflow: hidden;
		}
		
		#globalAnnouncementModal .modal-content .grid {
		    flex: 1;
		    min-height: 0;
		    overflow: hidden;
		}
		
		#globalAnnouncementModal .modal-content .grid > div {
		    display: flex;
		    flex-direction: column;
		    min-height: 0;
		    overflow: hidden;
		}
		
		#globalAnnouncementDisplay,
		#globalAnnouncementHistory,
		#globalAnnouncementPreview {
		    overflow-y: auto !important;
		    flex: 1;
		    min-height: 0;
		    -webkit-overflow-scrolling: touch;
		}
		
		#globalAnnouncementEditArea {
		    overflow: hidden;
		    display: flex;
		    flex-direction: column;
		    min-height: 0;
		}
		
		#globalAnnouncementEditor {
		    flex: 1;
		    resize: vertical;
		}
		
		#globalAnnouncementToolbar {
		    flex-shrink: 0;
		}
		
		@media (max-width: 768px) {
		    #globalAnnouncementModal .modal-content {
		        max-height: 95vh;
		        padding: 1rem;
		    }
		    #globalAnnouncementModal .grid {
		        gap: 0.75rem;
		    }
		}
		/* 全局公告模态框宽度自适应 */
		#globalAnnouncementModal .modal-content {
		    width: calc(100% - 2rem);   /* 默认左右各留1rem间隙 */
		    max-width: 56rem;           /* 超大屏幕限制最大宽度，避免过宽 */
		    margin-left: auto;
		    margin-right: auto;
		}
		
		/* 小屏（≥640px）时宽度稍大，仍留边距 */
		@media (min-width: 640px) {
		    #globalAnnouncementModal .modal-content {
		        width: 90%;
		        max-width: 64rem;
		    }
		}
		
		/* 大屏（≥1024px）时宽度占70%，更加舒适 */
		@media (min-width: 1024px) {
		    #globalAnnouncementModal .modal-content {
		        width: 70%;
		        max-width: 72rem;
		    }
		}
    </style>
</head>

<body class="bg-gray-100 min-h-screen font-sans antialiased" data-locked="true">
    <!-- 重构版：关于按钮 -->
	<!-- 按钮容器（垂直排列） -->
	<div class="fixed bottom-6 right-6 flex flex-row gap-3 z-[9999999]" id="buttonContainer">
	    <div class="i-button" id="globalAnnouncementBtn" title="全局公告">📢</div>
	    <div class="i-button" id="aboutButton" title="关于本系统">i</div>
	    <div class="i-button" id="randomButton" title="随机学生">RD</div>
	</div>
	<!-- Toast 容器（独立固定定位，初始隐藏） -->
	<div id="toastContainer" class="fixed flex flex-col-reverse gap-2 z-[200] pointer-events-none" style="display: none;"></div>
    <!-- 重构版：关于模态框 -->
    <div id="aboutModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden transition-opacity duration-300 opacity-0" style="backdrop-filter: blur(2px); z-index: 999999 !important;">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full mx-4 p-6 border border-blue-200 about-card">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-purple-700">✨ 像素创梦™ · 融合版</h2>
                <button id="closeAbout" class="text-gray-500 hover:text-gray-800 text-2xl leading-5">&times;</button>
            </div>
            <div class="space-y-3 text-gray-700">
                <p class="flex items-center gap-2"><span class="text-blue-600 text-lg">🎯</span> <span class="font-semibold">最终归属团队：</span>像素创梦™</p>
                <p class="flex items-center gap-2"><span class="text-blue-600 text-lg">👨‍💻</span> <span class="font-semibold">研发：</span>易思宸 <span class="text-sm text-gray-500">(主程)</span>  ·  曾梓轩 <span class="text-sm text-gray-500">(辅助)</span></p>
                <p class="flex items-center gap-2"><span class="text-blue-600 text-lg">🧪</span> <span class="font-semibold">当前版本：</span>融合版 <span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded-full text-sm">Merge V21.2</span></p>
                <p class="flex items-center gap-2"><span class="text-blue-600 text-lg">⚙️</span> <span class="font-semibold">技术栈(使用过的技术)：</span>CSS · Tailwind · TCP-Python (端口5000) · DeepSeek · 豆包 · Cloudflare · PYTHON/HTML · SakuraFRP</p>
                <div class="border-t border-dashed my-2"></div>
                <p class="text-sm text-amber-700 bg-amber-50 p-3 rounded-lg">🔔 若无法访问API，自动切换本地存储模式。本地面板完全可用。</p>
                <p class="text-xs text-gray-400 mt-2">© 2025 像素创梦 · 保留所有想象</p>
            </div>
        </div>
    </div>

    <!-- 主容器（整合原版+重构版结构） -->
    <div class="container mx-auto px-4 py-6 max-w-7xl relative" id="appContainer">
        <!-- 重构版：顶栏（班级名称 + 用户信息 + 锁定状态） -->
        <div class="flex flex-wrap items-center justify-between mb-4">
            <div class="flex items-center gap-3">
                <h1 class="text-3xl font-extrabold text-gray-800" id="classNameDisplay">🏫 银河一班</h1>
                <span id="lockStatusBadge" class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-700 font-semibold">🔒 已锁定</span>
            </div>
            <div class="flex items-center gap-3" id="userAuthSection">
                <div id="userInfo" class="hidden items-center gap-2">
                    <span class="text-sm text-gray-600">👋 <span id="currentUsername"></span></span>
                    <button id="logoutBtn" class="text-xs bg-gray-200 hover:bg-gray-300 px-3 py-1 rounded">退出</button>
                </div>
                <div id="loginButtons" class="flex gap-2">
                    <button id="loginBtn" class="text-sm bg-primary text-white px-4 py-1.5 rounded hover:bg-blue-600">登录</button>
                    <button id="registerBtn" class="text-sm bg-secondary text-white px-4 py-1.5 rounded hover:bg-slate-600">注册</button>
                </div>
            </div>
        </div>

        <!-- 重构版：主功能栏（支付/添加积分 + 锁定控制） -->
        <div class="bg-white p-4 rounded-xl shadow-sm mb-6 flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium text-gray-600">操作区：</span>
                <button id="payBtn" class="btn-success text-sm py-2"><i class="fa fa-credit-card mr-1"></i>支付 (扣正分)</button>
                <button id="addPointsBtn" class="btn-primary text-sm py-2"><i class="fa fa-plus-circle mr-1"></i>添加积分</button>
                <!-- 在操作区添加两个按钮（受锁定控制） -->
				<button id="addNoteBtn" class="btn-info text-sm py-2"><i class="fa fa-sticky-note mr-1"></i>添加学生注释</button>
				<button id="deleteNoteBtn" class="btn-warning text-sm py-2"><i class="fa fa-trash mr-1"></i>删除学生注释</button>
            </div>
            <div class="flex items-center gap-2 ml-auto">
                <span class="text-sm text-gray-500">锁定控制：</span>
                <button id="unlockBtn" class="btn-warning text-sm py-1.5"><i class="fa fa-unlock-alt mr-1"></i>解锁</button>
                <button id="lockBtn" class="btn-secondary text-sm py-1.5"><i class="fa fa-lock mr-1"></i>锁定</button>
            </div>
        </div>

        <!-- 整合版：选项卡导航（原版4个 + 重构版日志/设置） -->
        <div class="border-b border-gray-300 mb-6 overflow-x-auto whitespace-nowrap pb-1">
            <ul class="flex gap-2 text-sm font-medium" id="tabNav">
			    <li><button class="tab-active px-4 py-2" data-tab="home">🏠 主页</button></li>
			    <li><button class="tab-inactive px-4 py-2" data-tab="total-rank">🏆 总排名</button></li>
			    <li><button class="tab-inactive px-4 py-2" data-tab="positive-rank">➕ 正分排名</button></li>
			    <li><button class="tab-inactive px-4 py-2" data-tab="negative-rank">➖ 负分榜</button></li>
			    <li><button class="tab-inactive px-4 py-2" data-tab="all-students">📋 全部学生(表)</button></li>
			    <li><button class="tab-inactive px-4 py-2" data-tab="log-tab">📜 logs</button></li>
			    <li><button class="tab-inactive px-4 py-2" data-tab="settings-tab">⚙️ 设置</button></li>
			</ul>
        </div>

        <!-- 选项卡内容区域（整合所有功能） -->
        <div id="tabContent" class="min-h-[400px]">
        	<!-- 主页面板 -->
			<div class="tab-pane active" id="home">
			    <!-- 公告区域 -->
			    <div class="bg-white rounded-lg shadow p-5 mb-6">
			        <h3 class="text-lg font-semibold mb-3">📢 公告</h3>
			        <div id="announcementContent" class="text-gray-700 min-h-[60px]">
			            <!-- 动态加载公告内容 -->
			        </div>
			    </div>
			
			    <!-- 查询区域 -->
			    <div class="bg-white rounded-lg shadow p-5 mb-6">
			        <h3 class="text-lg font-semibold mb-3">🔍 学生查询</h3>
			        <div class="flex gap-2 max-w-md">
			            <input type="text" id="homeSearchInput" placeholder="请输入学号查询" class="input-field flex-grow">
			            <button id="homeSearchBtn" class="btn-secondary whitespace-nowrap">
			                <i class="fa fa-search mr-2"></i>查询
			            </button>
			        </div>
			    </div>
			
			    <!-- 分数卡片滚动区域 -->
			    <div class="bg-white rounded-lg shadow p-5 mb-6">
			        <h3 class="text-lg font-semibold mb-3">🎴 各个学生的分数情况</h3>
			        <div id="scoreCardCarousel" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 min-h-[200px]">
			            <!-- 动态生成三个卡片 -->
			        </div>
			    </div>
			
			    <!-- 统计区域（原全局统计） -->
			    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			        <!-- 学生积分 - 柱状图轮播 -->
					<div class="bg-white p-5 rounded-lg shadow">
					    <h3 class="text-lg font-semibold mb-3">📊 学生积分</h3>
					    <div class="relative h-[260px] w-full">
					        <canvas id="studentChartCanvas"></canvas>
					    </div>
					</div>
			        <!-- 班级统计 -->
			        <div class="bg-white p-5 rounded-lg shadow">
			            <h3 class="text-lg font-semibold mb-3">📈 班级统计</h3>
			            <div class="grid grid-cols-2 gap-3">
			                <div class="bg-blue-50 p-3 rounded text-center"><span class="text-xs text-gray-500">学生总数</span><p id="totalStudents" class="text-2xl font-bold text-primary">0</p></div>
			                <div class="bg-green-50 p-3 rounded text-center"><span class="text-xs text-gray-500">正分学生</span><p id="positiveStudents" class="text-2xl font-bold text-success">0</p></div>
			                <div class="bg-red-50 p-3 rounded text-center"><span class="text-xs text-gray-500">负分学生</span><p id="negativeStudents" class="text-2xl font-bold text-danger">0</p></div>
			                <div class="bg-amber-50 p-3 rounded text-center"><span class="text-xs text-gray-500">平均总分</span><p id="averageScore" class="text-2xl font-bold text-warning">0</p></div>
			            </div>
			        </div>
			    </div>
			</div>
            <!-- 原版：总排名（卡片模式） -->
            <div class="tab-pane hidden" id="total-rank">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="totalRankContainer"></div>
            </div>
            <div class="tab-pane hidden" id="positive-rank">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="positiveRankContainer"></div>
            </div>
            <div class="tab-pane hidden" id="negative-rank">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="negativeRankContainer"></div>
            </div>
            
            <!-- 重构版：全部学生（表格模式） -->
            <div class="tab-pane hidden" id="all-students">
                <div class="bg-white rounded-lg shadow overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200" id="studentTable">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">学号</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">姓名</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">正分</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">负分</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">总分</th>
                            </tr>
                        </thead>
                        <tbody id="studentTableBody" class="bg-white divide-y divide-gray-200"></tbody>
                    </table>
                </div>
            </div>
            
            <!-- 重构版：日志页 -->
            <div class="tab-pane hidden" id="log-tab">
                <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex justify-between items-center mb-3">
					    <h3 class="text-lg font-semibold">📋 System Logs</h3>
					    <div>
					        <button id="exportLogsBtn" class="btn-secondary text-sm"><i class="fa fa-download"></i> Export Stack</button>
					        <button id="clearLogsBtn" class="btn-danger text-sm ml-2"><i class="fa fa-trash"></i> 清空日志</button>
					    </div>
					</div>
                    <div class="overflow-x-auto max-h-96 border rounded">
                        <table class="min-w-full text-sm log-table" id="logTable">
                            <thead class="bg-gray-100 sticky top-0">
                                <tr>
                                    <th class="px-4 py-2 text-left">Time</th>
                                    <th class="px-4 py-2 text-left">Level</th>
                                    <th class="px-4 py-2 text-left">Action</th>
                                    <th class="px-4 py-2 text-left">Details</th>
                                </tr>
                            </thead>
                            <tbody id="logTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- 重构版：设置页 -->
            <div class="tab-pane hidden" id="settings-tab">
                <div class="bg-white rounded-lg shadow p-5" id="settingsPanel">
                    <div id="settingsPasswordWrap" class="max-w-md mx-auto">
                        <div class="text-center mb-4 text-gray-600">⚙️ 设置页需要当前账号密码验证</div>
                        <div class="flex gap-2">
                            <input type="password" id="settingsPasswordInput" placeholder="输入密码" class="input-field">
                            <button id="verifySettingsBtn" class="btn-primary whitespace-nowrap">验证</button>
                        </div>
                        <p class="text-xs text-gray-400 mt-2">默认密码: 123456 (当前登录用户)</p>
                    </div>
                    <div id="settingsContent" class="hidden space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="border rounded-lg p-4">
                            	<!-- 全局公告管理（仅管理员可见） -->
								<div class="border rounded-lg p-4" id="globalAnnouncementSettingsSection" style="display: none;">
								    <h4 class="font-bold mb-3">🌐 全局公告管理</h4>
								    <p class="text-sm text-gray-600 mb-2">当前全局公告内容：</p>
								    <div id="globalAnnouncementPreviewSettings" class="bg-gray-50 p-2 rounded text-sm max-h-32 overflow-y-auto mb-2"></div>
								    <button id="editGlobalAnnouncementFromSettings" class="btn-info text-sm">编辑全局公告</button>
								</div>
                                <h4 class="font-bold mb-3">📌 账号/班级设置</h4>
                                <div class="space-y-3">
                                    <div><label class="block text-sm">用户名</label><input type="text" id="settingUsername" class="input-field text-sm"></div>
                                    <div><label class="block text-sm">班级名</label><input type="text" id="settingClassName" class="input-field text-sm"></div>
                                    <div><label class="block text-sm">新密码(留空不变)</label><input type="password" id="settingNewPwd" class="input-field text-sm" placeholder="新密码"></div>
                                    <div><label class="block text-sm">确认密码</label><input type="password" id="settingConfirmPwd" class="input-field text-sm"></div>
									<!-- 新增公告输入框 -->
									<div><label class="block text-sm">公告</label>
									    <div class="flex gap-2">
									        <input type="text" id="settingAnnouncementPreview" class="input-field text-sm flex-1" readonly placeholder="点击编辑公告">
									        <button id="editClassAnnouncementBtn" class="btn-info text-sm">编辑公告</button>
									    </div>
									</div>
									<button id="updateAccountBtn" class="btn-primary w-full">更新账户信息</button>
                                </div>
                            </div>
                            <div class="border rounded-lg p-4">
                                <h4 class="font-bold mb-3">🧑‍🎓 学生管理(增/删/调分)</h4>
                                <div class="space-y-4">
                                    <div><label class="block text-sm">添加学生</label>
                                        <div class="flex gap-1 text-sm">
                                            <input type="text" id="setStudentId" placeholder="学号" class="input-field w-1/3">
                                            <input type="text" id="setStudentName" placeholder="姓名" class="input-field w-1/3">
                                            <input type="number" id="setStudentPos" value="0" class="input-field w-1/6">
                                            <input type="number" id="setStudentNeg" value="0" class="input-field w-1/6">
                                            <button id="adminAddStudent" class="btn-success text-sm px-3">➕</button>
                                        </div>
                                    </div>
                                    <div><label class="block text-sm">删除学生 (学号)</label>
                                        <div class="flex gap-2">
                                            <input type="text" id="adminDelId" class="input-field" placeholder="学号">
                                            <button id="adminDelBtn" class="btn-danger">删除</button>
                                        </div>
                                    </div>
                                    <div><label class="block text-sm">调整学生分数 (充值/扣除合一)</label>
                                        <div class="grid grid-cols-2 gap-1 text-sm">
                                            <input type="text" id="adminAdjId" placeholder="学号" class="input-field col-span-2 mb-1">
                                            <input type="number" id="adminAdjPos" value="0" placeholder="正分变动" class="input-field">
                                            <input type="number" id="adminAdjNeg" value="0" placeholder="负分变动" class="input-field">
                                            <button id="adminAdjBtn" class="btn-primary col-span-2 mt-1">确认调整</button>
                                        </div>
                                    </div>
                                    <div class="mt-4 border-t pt-4">
									    <h5 class="font-semibold mb-2 text-red-600">⚠️ 危险操作</h5>
									    <button id="clearAllScoresBtn" class="btn-danger text-sm w-full"><i class="fa fa-trash"></i> 清除所有学生积分</button>
									</div>
                                    <div class="mt-4 border-t pt-4">
									    <h5 class="font-semibold mb-2">📦 数据操作</h5>
									    <div class="flex gap-2">
									        <button id="exportDataBtn" class="btn-info text-sm flex-1"><i class="fa fa-download"></i> 导出学生数据</button>
									        <button id="importDataBtn" class="btn-warning text-sm flex-1"><i class="fa fa-upload"></i> 导入学生数据</button>
									    </div>
									    <input type="file" id="importFileInput" class="hidden" accept=".json,application/json">
									</div>
                                </div>
                            </div>
                        </div>
                        <!-- 在 settingsContent 的末尾，</div> 之前添加 -->
						<div id="adminPanel" class="border rounded-lg p-4 hidden">
						    <h4 class="font-bold mb-3">👑 用户管理</h4>
						    <div class="overflow-x-auto">
						        <table class="min-w-full text-sm">
						            <thead>
						                <tr><th>用户名</th><th>创建时间</th><th>角色</th><th>密码</th><th>操作</th></tr>
						            </thead>
						            <tbody id="userListBody"></tbody>
						        </table>
						    </div>
						</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 原版：操作区域（保留，兼容重构版支付/添加积分） -->
