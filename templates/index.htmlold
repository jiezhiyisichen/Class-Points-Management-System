    </div>

    <!-- 原版：所有模态框（保留） -->
    <!-- 添加注释模态框 -->
	<div id="addNoteModal" class="modal-backdrop hidden opacity-0">
	    <div class="modal-content p-5">
	        <h3 class="text-lg font-bold mb-3">添加学生注释</h3>
	        <div class="space-y-3">
	            <input type="text" id="noteStudentId" placeholder="学号" class="input-field">
	            <textarea id="noteContent" placeholder="注释内容" class="input-field" rows="3"></textarea>
	            <div class="flex justify-end gap-2">
	                <button class="close-modal btn-secondary">取消</button>
	                <button id="confirmAddNote" class="btn-primary">确认</button>
	            </div>
	        </div>
	    </div>
	</div>
	
	<!-- 删除注释模态框 -->
	<div id="deleteNoteModal" class="modal-backdrop hidden opacity-0">
	    <div class="modal-content p-5">
	        <h3 class="text-lg font-bold mb-3">删除学生注释</h3>
	        <div class="space-y-3">
	            <input type="text" id="delNoteStudentId" placeholder="学号" class="input-field">
	            <input type="number" id="delNoteNumber" placeholder="注释编号" class="input-field" min="1">
	            <div class="flex justify-end gap-2">
	                <button class="close-modal btn-secondary">取消</button>
	                <button id="confirmDeleteNote" class="btn-danger">删除</button>
	            </div>
	        </div>
	    </div>
	</div>
    <div id="addStudentModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold">添加学生</h3>
                <button class="close-modal text-gray-500 hover:text-gray-700">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <form id="addStudentForm">
                <div class="mb-4">
                    <label for="studentId" class="block text-gray-700 mb-2">学号</label>
                    <input type="text" id="studentId" class="input-field" required>
                </div>
                <div class="mb-4">
                    <label for="studentName" class="block text-gray-700 mb-2">姓名</label>
                    <input type="text" id="studentName" class="input-field" required>
                </div>
                <div class="mb-4">
                    <label for="positiveScore" class="block text-gray-700 mb-2">初始正分</label>
                    <input type="number" id="positiveScore" class="input-field" value="0" min="0" required>
                </div>
                <div class="mb-6">
                    <label for="negativeScore" class="block text-gray-700 mb-2">初始负分</label>
                    <input type="number" id="negativeScore" class="input-field" value="0" min="0" required>
                </div>
                <div class="flex justify-end gap-3">
                    <button type="button" class="close-modal btn-secondary">取消</button>
                    <button type="submit" class="btn-primary">添加</button>
                </div>
            </form>
        </div>
    </div>

    <div id="deleteStudentModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold">删除学生</h3>
                <button class="close-modal text-gray-500 hover:text-gray-700">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <form id="deleteStudentForm">
                <div class="mb-6">
                    <label for="deleteStudentId" class="block text-gray-700 mb-2">学号</label>
                    <input type="text" id="deleteStudentId" class="input-field" required>
                </div>
                <div class="flex justify-end gap-3">
                    <button type="button" class="close-modal btn-secondary">取消</button>
                    <button type="submit" class="btn-danger">删除</button>
                </div>
            </form>
        </div>
    </div>

    <div id="passwordModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold">密码验证</h3>
                <button class="close-modal text-gray-500 hover:text-gray-700">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <form id="passwordForm">
                <div class="mb-6">
                    <label for="password" class="block text-gray-700 mb-2">请输入操作密码</label>
                    <input type="password" id="password" class="input-field" required>
                    <p class="text-gray-500 text-sm mt-1">默认密码：54321</p>
                </div>
                <div class="flex justify-end gap-3">
                    <button type="button" class="close-modal btn-secondary">取消</button>
                    <button type="submit" class="btn-primary">确认</button>
                </div>
            </form>
        </div>
    </div>

    <div id="scoreAdjustModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold" id="scoreAdjustTitle">积分调整</h3>
                <button class="close-modal text-gray-500 hover:text-gray-700">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <form id="scoreAdjustForm">
                <div class="mb-4">
                    <label for="adjustStudentId" class="block text-gray-700 mb-2">学号</label>
                    <input type="text" id="adjustStudentId" class="input-field" required>
                </div>
                <div class="mb-4">
                    <label for="adjustPositiveScore" class="block text-gray-700 mb-2">正分调整</label>
                    <input type="number" id="adjustPositiveScore" class="input-field" value="0" min="0" required>
                </div>
                <div class="mb-6">
                    <label for="adjustNegativeScore" class="block text-gray-700 mb-2">负分调整</label>
                    <input type="number" id="adjustNegativeScore" class="input-field" value="0" min="0" required>
                </div>
                <div class="flex justify-end gap-3">
                    <button type="button" class="close-modal btn-secondary">取消</button>
                    <button type="submit" class="btn-primary">确认</button>
                </div>
            </form>
        </div>
    </div>

    <div id="searchResultModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold">学生信息</h3>
                <button class="close-modal text-gray-500 hover:text-gray-700">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div id="searchResultContent">
                <!-- 查询结果将通过JavaScript动态生成 -->
            </div>
            <div class="mt-6 flex justify-end">
                <button class="close-modal btn-secondary">关闭</button>
            </div>
        </div>
    </div>

    <div id="loginModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-5">
            <h3 class="text-lg font-bold">登录</h3>
            <input id="loginUsername" class="input-field my-2" placeholder="用户名">
            <input id="loginPassword" type="password" class="input-field" placeholder="密码">
            <div class="flex justify-end gap-2 mt-3">
                <button class="close-modal btn-secondary">取消</button>
                <button id="loginSubmitBtn" class="btn-primary">登录</button>
            </div>
        </div>
    </div>

    <div id="registerModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-5">
            <h3 class="text-lg font-bold">注册</h3>
            <input id="regUsername" class="input-field my-2" placeholder="用户名">
            <input id="regPassword" type="password" class="input-field" placeholder="密码">
            <div class="flex justify-end gap-2 mt-3">
                <button class="close-modal btn-secondary">取消</button>
                <button id="registerSubmitBtn" class="btn-primary">注册</button>
            </div>
        </div>
    </div>

    <!-- 重构版：新增模态框 -->
    <div id="genericPasswordModal" class="modal-backdrop hidden opacity-0">
        <div class="modal-content p-5">
            <h3 class="text-lg font-bold mb-3" id="genericModalTitle">验证密码</h3>
            <input type="password" id="genericPassword" class="input-field mb-4" placeholder="输入当前账号密码">
            <div class="flex justify-end gap-2">
                <button class="close-modal btn-secondary">取消</button>
                <button id="genericConfirmBtn" class="btn-primary">确认</button>
            </div>
        </div>
    </div>

    <div id="pointsActionModal" class="modal-backdrop hidden opacity-0">
	    <div class="modal-content p-5">
	        <h3 class="text-lg font-bold mb-2" id="pointsActionTitle">支付 (扣正分)</h3>
	        <div class="space-y-3">
	            <input type="text" id="actionStudentId" placeholder="学号" class="input-field">
	            <div id="pointsInputGroup">
	                <input type="number" id="actionPoints" placeholder="分数" value="1" min="1" class="input-field">
	            </div>
	            <div id="extraPosNeg" class="hidden grid grid-cols-2 gap-2">
	                <input type="number" id="actionPos" placeholder="正分增加" value="0" class="input-field">
	                <input type="number" id="actionNeg" placeholder="负分增加" value="0" class="input-field">
	            </div>
	            <div class="flex justify-end gap-2">
	                <button class="close-modal btn-secondary">取消</button>
	                <button id="confirmPointsAction" class="btn-primary">确认</button>
	            </div>
	        </div>
	    </div>
	</div>
	<!-- 随机学生模态框 -->
	<div id="randomStudentModal" class="modal-backdrop hidden opacity-0">
	    <div class="modal-content p-6">
	        <div class="flex justify-between items-center mb-4">
	            <h3 class="text-xl font-semibold">ramdon-students</h3>
	            <button class="close-modal text-gray-500 hover:text-gray-700">
	                <i class="fa fa-times"></i>
	            </button>
	        </div>
	        <div id="randomStudentContent" class="min-h-[100px]">
	            <!-- 动态填充内容 -->
	        </div>
	        <div class="mt-6 flex justify-end">
	            <button class="close-modal btn-secondary">关闭</button>
	        </div>
	    </div>
	</div>
    <!-- 原版：Toast提示（保留） -->
