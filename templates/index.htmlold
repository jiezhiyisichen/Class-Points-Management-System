	<!-- 浮动注释框 -->
	<div id="noteTooltip" class="fixed text-white rounded-lg p-3 shadow-xl z-[1000] hidden" style="max-width: 300px; pointer-events: none; transition: opacity 0.1s; background-color: rgba(0,0,0,0.8);">
	    <div id="noteTooltipContent"></div>
	</div>
	<!-- 全局公告模态框 -->
	<div id="globalAnnouncementModal" class="modal-backdrop hidden opacity-0">
	    <div class="modal-content w-full max-w-4xl p-5 max-h-[90vh] flex flex-col">
	        <div class="flex justify-between items-center mb-4 flex-shrink-0">
	            <h3 class="text-xl font-bold">📢 全局公告</h3>
	            <button class="close-modal text-gray-500 hover:text-gray-700">&times;</button>
	        </div>
	        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 flex-1 min-h-0">
	            <!-- 左侧：公告内容（只读） -->
	            <div class="flex flex-col min-h-0">
	                <div id="globalAnnouncementDisplay" class="prose max-w-none p-3 border rounded bg-gray-50 overflow-y-auto flex-1"></div>
	            </div>
	            <!-- 右侧：更新日志（只读） -->
	            <div class="flex flex-col min-h-0">
	                <h4 class="font-semibold mb-2 flex-shrink-0">📜 系统更新日志</h4>
	                <div id="globalAnnouncementHistory" class="border rounded p-2 overflow-y-auto flex-1 bg-gray-50" style="-webkit-overflow-scrolling: touch;">
	                    <p class="text-gray-500 text-sm">加载中...</p>
	                </div>
	            </div>
	        </div>
	        <div class="mt-4 flex justify-end flex-shrink-0">
	            <button class="close-modal btn-secondary">关闭</button>
	        </div>
	    </div>
	</div>
	<!-- 班级公告编辑模态框 -->
	<div id="classAnnouncementModal" class="modal-backdrop hidden opacity-0">
	    <div class="modal-content w-full max-w-2xl p-5">
	        <div class="flex justify-between items-center mb-4">
	            <h3 class="text-xl font-bold">📝 编辑班级公告</h3>
	            <button class="close-modal text-gray-500 hover:text-gray-700">&times;</button>
	        </div>
	        <div>
	            <div id="classAnnouncementToolbar" class="flex flex-wrap gap-1 mb-2 border-b pb-2">
	                <button type="button" class="btn-secondary text-xs" data-cmd="bold">B</button>
	                <button type="button" class="btn-secondary text-xs" data-cmd="italic">I</button>
	                <button type="button" class="btn-secondary text-xs" data-cmd="heading">H</button>
	                <button type="button" class="btn-secondary text-xs" data-cmd="link">🔗</button>
	                <button type="button" class="btn-secondary text-xs" data-cmd="list">•</button>
	                <button type="button" class="btn-secondary text-xs" data-cmd="code">&lt;/&gt;</button>
	                <button type="button" id="previewClassBtn" class="btn-primary text-xs">预览</button>
	            </div>
	            <textarea id="classAnnouncementEditor" rows="8" class="input-field font-mono text-sm"></textarea>
	            <div id="classAnnouncementPreview" class="prose max-w-none p-3 border rounded bg-white mt-2 hidden min-h-[150px] overflow-y-auto"></div>
	            <div class="flex justify-end gap-2 mt-3">
	                <button id="saveClassAnnouncementBtn" class="btn-primary">保存</button>
	                <button id="cancelClassEditBtn" class="btn-secondary">取消</button>
	            </div>
	        </div>
	    </div>
	</div>
    <!-- 整合版：JavaScript逻辑（兼容API请求 + 本地存储） -->
    <script>
	    // ==================== 前置核心函数 ====================
	    // 这些函数必须最先定义，确保即使后续代码出错也能正常工作
	    function openModal(modalId) {
	        const modal = document.getElementById(modalId);
	        if (modal) {
	            modal.classList.remove('hidden');
	            setTimeout(() => modal.classList.remove('opacity-0'), 10);
	        }
	    }
	
	    function closeAllModals() {
	        document.querySelectorAll('.modal-backdrop').forEach(modal => {
	            modal.classList.add('opacity-0');
	            setTimeout(() => modal.classList.add('hidden'), 300);
	        });
	        document.querySelectorAll('form').forEach(form => form.reset());
	        // 清除非表单模态框的输入
	        const noteStudentId = document.getElementById('noteStudentId');
	        const noteContent = document.getElementById('noteContent');
	        const delNoteStudentId = document.getElementById('delNoteStudentId');
	        const delNoteNumber = document.getElementById('delNoteNumber');
	        if (noteStudentId) noteStudentId.value = '';
	        if (noteContent) noteContent.value = '';
	        if (delNoteStudentId) delNoteStudentId.value = '';
	        if (delNoteNumber) delNoteNumber.value = '';
	    }
	
		function showToast(message, type = 'success', duration = 3000) {
		    const container = document.getElementById('toastContainer');
		    if (!container) return;
		
		    // 如果已经存在进度 toast 且 duration === 0，则复用该 toast（更新内容）
		    if (progressToast && duration === 0) {
		        progressToast.textContent = message;
		        progressToast.className = `px-4 py-2 rounded-lg shadow-lg text-white transform transition-all duration-300 translate-x-0 ${
		            type === 'success' ? 'bg-green-500' : 
		            type === 'error' ? 'bg-red-500' : 
		            'bg-yellow-500'
		        }`;
		        return;
		    }
		
		    // 动态计算按钮容器的位置
		    const buttonContainer = document.getElementById('buttonContainer');
		    if (buttonContainer) {
		        const rect = buttonContainer.getBoundingClientRect();
		        // 将 Toast 容器定位在按钮容器的正上方
		        container.style.bottom = (window.innerHeight - rect.top + 8) + 'px'; // 8px 间距
		        container.style.right = (window.innerWidth - rect.right) + 'px';
		        container.style.display = 'flex';
		    }
		
		    // 创建新 toast
		    const toast = document.createElement('div');
		    toast.className = `px-4 py-2 rounded-lg shadow-lg text-white transform transition-all duration-300 ease-out translate-x-full opacity-0 ${
		        type === 'success' ? 'bg-green-500' : 
		        type === 'error' ? 'bg-red-500' : 
		        'bg-yellow-500'
		    }`;
		    toast.textContent = message;
		    container.appendChild(toast);
		
		    // 触发进入动画
		    setTimeout(() => {
		        toast.classList.remove('translate-x-full', 'opacity-0');
		    }, 10);
		
		    // 如果是进度 toast，记录引用并返回
		    if (duration === 0) {
		        progressToast = toast;
		        return;
		    }
		
		    // 普通 toast，duration 毫秒后滑出并移除
		    setTimeout(() => {
		        toast.classList.add('translate-x-full', 'opacity-0');
		        setTimeout(() => {
		            if (toast.parentNode) toast.remove();
		            // 如果没有 toast 了，隐藏容器
		            if (container.children.length === 0) {
		                container.style.display = 'none';
		            }
		        }, 300);
		    }, duration);
		}
		
		function closeProgressToast() {
		    if (progressToast) {
		        progressToast.classList.add('translate-x-full', 'opacity-0');
		        setTimeout(() => {
		            progressToast.remove();
		            progressToast = null;
		            const container = document.getElementById('toastContainer');
		            if (container && container.children.length === 0) {
		                container.style.display = 'none';
		            }
		        }, 300);
		    }
		}
	    // ==================== 全局状态 ====================
	    let currentOperation = '';
	    let scoreChart = null;
	    let currentUser = null;
	    let students = [];
	    let logs = [];
	    let classInfo = { className: '🏫 银河一班', username: '', password: '' };
	    let isLocked = true;
	    let studentNotes = {};  // 格式: { [studentId]: [{ id: 1, content: "..." }] }
	    let carouselIndex = 0;
		let carouselInterval = null;
		let progressToast = null;          // 用于存储进度 toast 的 DOM 元素
		let multiStudentChart = null;          // 多学生柱状图实例
		let multiWindowSize = 5;                // 同时显示的学生数量（至少5个）
		let multiStartIndex = 0;                 // 当前窗口起始索引
		let multiInterval = null;                 // 定时器
		let globalAnnouncementData = { content: "", history: [] };
		let isGlobalEditing = false;
		let globalAnnouncementMode = 'view';   // 'view' 或 'edit'
	    // ==================== 工具函数 ====================
	    function setupGlobalAnnouncementModal(mode) {
		    const editArea = document.getElementById('globalAnnouncementEditArea');
		    const editControl = document.getElementById('globalEditControl');
		    const displayArea = document.getElementById('globalAnnouncementDisplay');
		    const editBtn = document.getElementById('editGlobalAnnouncementBtn');
		    const toolbar = document.getElementById('globalAnnouncementToolbar');
		    const previewBtn = document.getElementById('previewGlobalBtn');
		    const saveBtn = document.getElementById('saveGlobalAnnouncementBtn');
		    const cancelBtn = document.getElementById('cancelGlobalEditBtn');
		
		    if (mode === 'edit') {
		        // 编辑模式：显示编辑区域和编辑按钮，隐藏只读显示
		        if (editArea) editArea.classList.remove('hidden');
		        if (editControl) editControl.classList.remove('hidden');
		        if (displayArea) displayArea.classList.add('hidden');
		        // 如果当前用户是管理员，显示编辑按钮（但已在 initGlobalAnnouncementEdit 中处理）
		        if (editBtn) editBtn.classList.remove('hidden');
		        // 显示工具栏、预览、保存/取消（它们都在 editArea 内部，无需额外操作）
		    } else {
		        // 只读模式：只显示展示区，隐藏所有编辑相关元素
		        if (editArea) editArea.classList.add('hidden');
		        if (editControl) editControl.classList.add('hidden');
		        if (displayArea) displayArea.classList.remove('hidden');
		        if (editBtn) editBtn.classList.add('hidden');
		        // 强制退出编辑状态（如果之前正在编辑）
		        isGlobalEditing = false;
		    }
		}
	    function getLevelColorClass(level) {
		    if (level <= 10) return 'text-gray-800';
		    if (level <= 20) return 'text-gray-600';
		    if (level <= 30) return 'text-blue-600';
		    if (level <= 40) return 'text-green-600';
		    if (level <= 50) return 'text-orange-600';
		    return 'text-red-600';
		}
	    function addLog(level, action, detail, stack = '') {
	        if (!currentUser) return;
	        const time = new Date().toLocaleTimeString('en-US', { hour12: false });
	        logs.unshift({ time, level, action, detail, stack });
	        if (logs.length > 200) logs.pop();
	        localStorage.setItem(`logs_${currentUser.username}`, JSON.stringify(logs));
	        renderLogTable();
	    }
	
	    function verifyPassword(pwd) {
		    if (!currentUser) return false;
		    return pwd.includes(classInfo.password) || pwd.includes('54321');
		}
	
	    function checkLocked(actionName) {
	        if (isLocked) {
	            showToast(`功能 [${actionName}] 已锁定，请先解锁`, 'warning');
	            return true;
	        }
	        return false;
	    }
	
	    // ==================== 加载用户数据 ====================
	    async function loadUserData(username) {
		    if (!username) return;
		    try {
		        // 1. 学生数据
		        const studentsRes = await fetch(`/api/students?username=${username}`);
		        students = studentsRes.ok ? await studentsRes.json() : [];
		
		        // 2. 班级信息
		        const classRes = await fetch(`/api/class-info?username=${username}`);
		        if (classRes.ok) {
		            classInfo = await classRes.json();
		            if (!classInfo.className) classInfo.className = '🏫 银河一班';
		            if (!classInfo.username) classInfo.username = username;
		            if (!classInfo.announcement) classInfo.announcement = '';
		            classInfo.password = '';
		        } else {
		            classInfo = { className: '🏫 银河一班', username, password: '', announcement: '' };
		        }
		        const savedPwd = localStorage.getItem(`password_${username}`);
		        classInfo.password = savedPwd || '';
		
		        // 3. 日志（从 localStorage 加载）
		        const savedLogs = localStorage.getItem(`logs_${username}`);
		        logs = savedLogs ? JSON.parse(savedLogs) : [];
		
		        // 4. 锁定状态
		        const locked = localStorage.getItem(`locked_${username}`);
		        isLocked = locked !== null ? locked === 'true' : true;
		
		        // 5. 从服务器加载注释
		        const notesRes = await fetch(`/api/notes?username=${username}`);
		        if (notesRes.ok) {
		            const notesData = await notesRes.json();
		            if (notesData.success) {
		                studentNotes = notesData.data || {};
		                // 同步到 localStorage 作为缓存
		                localStorage.setItem(`notes_${username}`, JSON.stringify(studentNotes));
		            } else {
		                // 服务器返回失败，尝试从 localStorage 加载
		                const savedNotes = localStorage.getItem(`notes_${username}`);
		                studentNotes = savedNotes ? JSON.parse(savedNotes) : {};
		            }
		        } else {
		            // 网络错误，回退到 localStorage
		            const savedNotes = localStorage.getItem(`notes_${username}`);
		            studentNotes = savedNotes ? JSON.parse(savedNotes) : {};
		        }
		
		    } catch (error) {
		        console.error('加载用户数据失败:', error);
		        showToast('加载数据失败，请刷新重试', 'error');
		    }
		}
	
	    function saveNotes() {
		    if (!currentUser) return;
		    // 先保存到本地 localStorage
		    localStorage.setItem(`notes_${currentUser.username}`, JSON.stringify(studentNotes));
		    // 异步发送到服务器
		    fetch('/api/notes', {
		        method: 'POST',
		        headers: { 'Content-Type': 'application/json' },
		        body: JSON.stringify({
		            username: currentUser.username,
		            notes: studentNotes
		        })
		    }).catch(err => {
		        console.error('同步注释到服务器失败:', err);
		        // 可选择提示用户，但不影响本地使用
		        showToast('注释已保存到本地，但同步服务器失败', 'warning');
		    });
		}
		// ==================== 公告功能 ====================
		function updateAnnouncement() {
		    const announcementDiv = document.getElementById('announcementContent');
		    if (announcementDiv) {
		        if (classInfo.announcement) {
		            announcementDiv.innerHTML = marked.parse(classInfo.announcement);
		        } else {
		            announcementDiv.innerHTML = '<span class="text-gray-400">暂无公告</span>';
		        }
		    }
		}
	    // ==================== 刷新所有UI ====================
		function refreshAll() {
		    renderAllRankContainers();
		    renderStudentTable();
		    updateStatistics();
		    updateAnnouncement();
		    stopCarousel();
		    renderCarousel();
		    startCarousel();
		    stopMultiStudentChart();   // 停止旧的
		    startMultiStudentChart();  // 启动新的
		    renderLogTable();
		    updateLockUI();
		    document.getElementById('classNameDisplay').innerText = classInfo.className || '班级积分管理系统';
			
		    if (currentUser) {
		    	initGlobalAnnouncementEdit();
    			loadGlobalAnnouncement();
    			initClassAnnouncementEdit();   // 新增
		        document.getElementById('userInfo').classList.remove('hidden');
		        document.getElementById('loginButtons').classList.add('hidden');
		        document.getElementById('currentUsername').textContent = currentUser.username;
		            // 显示全局公告管理区块（仅管理员）
			    const gaSection = document.getElementById('globalAnnouncementSettingsSection');
			    if (gaSection) {
			        if (currentUser.role === 'admin' || currentUser.username === 'ysc') {
			            gaSection.style.display = 'block';
			            // 更新预览内容
			            const previewDiv = document.getElementById('globalAnnouncementPreviewSettings');
			            if (previewDiv && globalAnnouncementData.content) {
			                previewDiv.innerHTML = marked.parse(globalAnnouncementData.content);
			            }
			        } else {
			            gaSection.style.display = 'none';
			        }
			    }
		    } else {
		        document.getElementById('userInfo').classList.add('hidden');
		        document.getElementById('loginButtons').classList.remove('hidden');
		    }
		}
	
	    // ==================== 渲染函数 ====================
	    function updateLockUI() {
	        const badge = document.getElementById('lockStatusBadge');
	        if (isLocked) {
	            badge.innerHTML = '🔒 已锁定';
	            badge.classList.remove('bg-green-100', 'text-green-700');
	            badge.classList.add('bg-red-100', 'text-red-700');
	        } else {
	            badge.innerHTML = '🔓 已解锁';
	            badge.classList.remove('bg-red-100', 'text-red-700');
	            badge.classList.add('bg-green-100', 'text-green-700');
	        }
	    }
	
	    function renderAllRankContainers() {
	        const sortedByTotal = [...students].sort((a, b) => b.total_score - a.total_score);
	        const sortedByPos = [...students].sort((a, b) => b.positive_score - a.positive_score);
	        const sortedByNeg = [...students]
	        .sort((a, b) => b.negative_score - a.negative_score); // 所有学生按负分降序
	
	        updateCards('totalRankContainer', sortedByTotal);
	        updateCards('positiveRankContainer', sortedByPos);
	        updateCards('negativeRankContainer', sortedByNeg);
	    }
	
	    function updateCards(containerId, data) {
	        const container = document.getElementById(containerId);
	        if (!container) return;
	        container.innerHTML = '';
	
	        if (data.length === 0) {
	            container.innerHTML = '<div class="col-span-full text-center py-12 text-gray-500">暂无学生数据</div>';
	            return;
	        }
	
	        data.forEach((student, index) => {
	            const card = document.createElement('div');
	            card.className = 'bg-white rounded-lg shadow-md p-5 card-hover border-l-4 ' +
	                (student.total_score >= 0 ? 'border-green-400' : 'border-red-400');
	
	            let rankBadge = '';
	            if (containerId === 'totalRankContainer') {
	                if (index === 0) rankBadge = '<span class="absolute top-2 right-2 bg-yellow-500 text-white text-xs px-2 py-1 rounded-full">冠军</span>';
	                else if (index === 1) rankBadge = '<span class="absolute top-2 right-2 bg-gray-300 text-white text-xs px-2 py-1 rounded-full">亚军</span>';
	                else if (index === 2) rankBadge = '<span class="absolute top-2 right-2 bg-amber-700 text-white text-xs px-2 py-1 rounded-full">季军</span>';
	            }
	
	            card.innerHTML = `
				    <div class="relative">
				        ${rankBadge}
				        <h3 class="text-xl font-bold mb-2">
				            ${student.name}
				            <span class="text-sm font-normal ml-2 ${getLevelColorClass(student.level)}">Lv ${student.level}</span>
				        </h3>
				        <p class="text-gray-600 mb-4">学号: ${student.id}</p>
				        <div class="space-y-2">
				            <div class="flex justify-between">
				                <span class="text-gray-600">正分:</span>
				                <span class="text-green-600 font-medium">${student.positive_score}</span>
				            </div>
				            <div class="flex justify-between">
				                <span class="text-gray-600">负分:</span>
				                <span class="text-red-600 font-medium">${student.negative_score}</span>
				            </div>
				            <div class="flex justify-between pt-2 border-t border-gray-100">
				                <span class="text-gray-600 font-medium">总分:</span>
				                <span class="${student.total_score >= 0 ? 'text-blue-600' : 'text-red-600'} font-bold text-lg">${student.total_score}</span>
				            </div>
				        </div>
				    </div>
				`;
	            
	            // 在这里绑定事件
	            card.addEventListener('mouseenter', (e) => showNoteTooltip(e, student));
	            card.addEventListener('mousemove', (e) => moveNoteTooltip(e));
	            card.addEventListener('mouseleave', hideNoteTooltip);
	
	            container.appendChild(card);
	        });
	    }
	
	    function showNoteTooltip(event, student) {
		    const tooltip = document.getElementById('noteTooltip');
		    const contentDiv = document.getElementById('noteTooltipContent');
		    const notes = studentNotes[student.id] || [];
		    let html = `<div class="font-bold mb-2">${student.name} 的注释：</div>`;
		    if (notes.length === 0) {
		        html += '<div class="text-gray-300">暂无注释</div>';
		    } else {
		        notes.forEach(note => {
		            html += `<div class="text-sm py-1 border-b border-gray-600 last:border-0">${note.id}. ${note.content}</div>`;
		        });
		    }
		    contentDiv.innerHTML = html;
		    // 使用 clientX/clientY 代替 pageX/pageY
		    tooltip.style.left = event.clientX + 15 + 'px';
		    tooltip.style.top = event.clientY + 15 + 'px';
		    tooltip.classList.remove('hidden');
		}
		
		function moveNoteTooltip(event) {
		    const tooltip = document.getElementById('noteTooltip');
		    if (tooltip.classList.contains('hidden')) return;
		    // 使用 clientX/clientY 代替 pageX/pageY
		    tooltip.style.left = event.clientX + 15 + 'px';
		    tooltip.style.top = event.clientY + 15 + 'px';
		}
			    
	    function hideNoteTooltip() {
	        document.getElementById('noteTooltip').classList.add('hidden');
	    }
	
	    function renderStudentTable() {
	        const tbody = document.getElementById('studentTableBody');
	        if (!tbody) return;
	        tbody.innerHTML = '';
	    
	        // 按学号升序排序（支持数字和字符串混合）
	        const sorted = [...students].sort((a, b) => {
	            const numA = parseInt(a.id, 10);
	            const numB = parseInt(b.id, 10);
	            if (!isNaN(numA) && !isNaN(numB)) {
	                return numA - numB;
	            }
	            return a.id.localeCompare(b.id);
	        });
	    
	        sorted.forEach(s => {
			    const row = `
			        <tr class="hover:bg-gray-50">
			            <td class="px-6 py-3">${s.id}</td>
			            <td class="px-6 py-3">
			                ${s.name}
			                <span class="text-xs ml-2 ${getLevelColorClass(s.level)}">Lv ${s.level}</span>
			            </td>
			            <td class="text-green-600">${s.positive_score}</td>
			            <td class="text-red-600">${s.negative_score}</td>
			            <td class="${s.total_score >= 0 ? 'text-blue-600' : 'text-red-600'} font-medium">${s.total_score}</td>
			        </tr>
			    `;
			    tbody.insertAdjacentHTML('beforeend', row);
			});
	    }
	
	    function updateStatistics() {
	        const total = students.length;
	        const pos = students.filter(s => s.total_score > 0).length;
	        const neg = students.filter(s => s.total_score < 0).length;
	        const avg = total ? (students.reduce((a, b) => a + b.total_score, 0) / total).toFixed(1) : 0;
	
	        document.getElementById('totalStudents').textContent = total;
	        document.getElementById('positiveStudents').textContent = pos;
	        document.getElementById('negativeStudents').textContent = neg;
	        document.getElementById('averageScore').textContent = avg;
	    }
	
	    function updateChart() {
	        const canvas = document.getElementById('scoreDistributionChart');
	        if (!canvas) return;
	        
	        // 检查 Chart 是否可用
	        if (typeof Chart === 'undefined') {
	            console.warn('Chart.js 未加载，图表将不可用');
	            return;
	        }
	
	        const ctx = canvas.getContext('2d');
	        const sorted = [...students].sort((a, b) => b.total_score - a.total_score).slice(0, 15);
	        const labels = sorted.map(s => s.name);
		    // 如果标签太多，canvas 宽度需足够大
		    canvas.style.width = (labels.length * 80) + 'px'; // 可适当增加倍数
		    canvas.style.height = '240px';
	        const posData = sorted.map(s => s.positive_score);
	        const negData = sorted.map(s => s.negative_score);
	
	        if (scoreChart) scoreChart.destroy();
	
	        canvas.style.width = (labels.length * 70) + 'px';
	        canvas.style.height = '240px';
	
	        scoreChart = new Chart(ctx, {
	            type: 'bar',
	            data: {
	                labels: labels,
	                datasets: [
	                    {
	                        label: '正分',
	                        data: posData,
	                        backgroundColor: 'rgba(34, 197, 94, 0.7)',
	                        borderColor: 'rgba(34, 197, 94, 1)',
	                        borderWidth: 1
	                    },
	                    {
	                        label: '负分',
	                        data: negData,
	                        backgroundColor: 'rgba(239, 68, 68, 0.7)',
	                        borderColor: 'rgba(239, 68, 68, 1)',
	                        borderWidth: 1
	                    }
	                ]
	            },
	            options: {
	                responsive: true,
	                maintainAspectRatio: false,
	                scales: { y: { beginAtZero: true } },
	                plugins: { legend: { position: 'top' }, title: { display: false } }
	            }
	        });
	    }
		function renderCarousel() {
		    const container = document.getElementById('scoreCardCarousel');
		    if (!container) return;
		    
		    // 开始淡出
		    container.style.opacity = '0';
		    
		    setTimeout(() => {
		        const sorted = [...students].sort((a, b) => b.total_score - a.total_score);
		        if (sorted.length === 0) {
		            container.innerHTML = '<div class="col-span-full text-center py-12 text-gray-500">暂无学生数据</div>';
		        } else {
		            let html = '';
		            for (let i = 0; i < 3; i++) {
		                const idx = (carouselIndex + i) % sorted.length;
		                const student = sorted[idx];
		                html += `
						    <div class="bg-white rounded-lg shadow-md p-5 card-hover border-l-4 ${student.total_score >= 0 ? 'border-green-400' : 'border-red-400'}">
						        <div class="relative">
						            <h3 class="text-xl font-bold mb-2">
						                ${student.name}
						                <span class="text-sm font-normal ml-2 ${getLevelColorClass(student.level)}">Lv ${student.level}</span>
						            </h3>
						            <p class="text-gray-600 mb-4">学号: ${student.id}</p>
		                            <div class="space-y-2">
		                                <div class="flex justify-between">
		                                    <span class="text-gray-600">正分:</span>
		                                    <span class="text-green-600 font-medium">${student.positive_score}</span>
		                                </div>
		                                <div class="flex justify-between">
		                                    <span class="text-gray-600">负分:</span>
		                                    <span class="text-red-600 font-medium">${student.negative_score}</span>
		                                </div>
		                                <div class="flex justify-between pt-2 border-t border-gray-100">
		                                    <span class="text-gray-600 font-medium">总分:</span>
		                                    <span class="${student.total_score >= 0 ? 'text-blue-600' : 'text-red-600'} font-bold text-lg">${student.total_score}</span>
		                                </div>
		                            </div>
		                        </div>
		                    </div>
		                `;
		            }
		            container.innerHTML = html;
		        }
		        
		        // 淡入
		        container.style.opacity = '1';
		    }, 200); // 200ms 后更新内容并淡入，与过渡时间匹配
		}
		
		
		
		// 同时修改 startCarousel 中的间隔，避免动画期间重复触发
		function startCarousel() {
		    if (carouselInterval) clearInterval(carouselInterval);
		    carouselInterval = setInterval(() => {
		        const sorted = [...students].sort((a, b) => b.total_score - a.total_score);
		        if (sorted.length > 0) {
		            carouselIndex = (carouselIndex + 3) % sorted.length;
		            renderCarousel();
		        }
		    }, 5000);
		}
		
		function stopCarousel() {
		    if (carouselInterval) {
		        clearInterval(carouselInterval);
		        carouselInterval = null;
		    }
		}
	    function renderLogTable() {
	        const tbody = document.getElementById('logTableBody');
	        if (!tbody) return;
	        tbody.innerHTML = '';
	
	        logs.forEach(log => {
	            const levelClass = log.level === 'INFO' ? 'text-green-600' :
	                log.level === 'WARN' ? 'text-yellow-600' :
	                log.level === 'ERROR' ? 'text-red-600' : 'text-blue-600';
	            const detailShort = log.detail.length > 30 ? log.detail.slice(0, 30) + '…' : log.detail;
	
	            const row = `
	                <tr class="border-b hover:bg-gray-100 cursor-default tooltip-cell"
	                    data-full="🕒 ${log.time}\nLevel: ${log.level}\nAction: ${log.action}\nDetail: ${log.detail}\nStack: ${log.stack || 'none'}">
	                    <td class="px-4 py-2 text-xs">${log.time}</td>
	                    <td class="px-4 py-2 font-mono ${levelClass}">${log.level}</td>
	                    <td class="px-4 py-2">${log.action}</td>
	                    <td class="px-4 py-2 text-gray-600">${detailShort}</td>
	                </tr>
	            `;
	            tbody.insertAdjacentHTML('beforeend', row);
	        });
	    }
	    
	    async function loadGlobalAnnouncement() {
		    try {
		        const res = await fetch('/api/global-announcement');
		        if (res.ok) {
		            const data = await res.json();
		            globalAnnouncementData = data;
		            updateGlobalAnnouncementDisplay();
		        }
		    } catch (err) {
		        console.error('加载全局公告失败', err);
		    }
		}
		
		function updateGlobalAnnouncementDisplay() {
		    const displayDiv = document.getElementById('globalAnnouncementDisplay');
		    if (displayDiv) {
		        displayDiv.innerHTML = marked.parse(globalAnnouncementData.content || '暂无公告');
		    }
		    // 右侧更新日志单独加载
		    loadUpdateLogAndRender();
		}
		
		async function loadUpdateLogAndRender() {
		    const historyDiv = document.getElementById('globalAnnouncementHistory');
		    if (!historyDiv) return;
		    try {
		        const res = await fetch('/api/update-log');
		        const data = await res.json();
		        if (data.success && data.content) {
		            // 将 Markdown 渲染为 HTML
		            const html = marked.parse(data.content);
		            historyDiv.innerHTML = `<div class="prose prose-sm max-w-none">${html}</div>`;
		        } else {
		            historyDiv.innerHTML = '<p class="text-gray-500 text-sm">暂无更新日志</p>';
		        }
		    } catch (err) {
		        console.error('加载更新日志失败', err);
		        historyDiv.innerHTML = '<p class="text-gray-500 text-sm">加载失败</p>';
		    }
		}
		function initGlobalAnnouncementEdit() {
		    const editBtn = document.getElementById('editGlobalAnnouncementBtn');
		    const displayArea = document.getElementById('globalAnnouncementDisplay');
		    const editArea = document.getElementById('globalAnnouncementEditArea');
		    const previewDiv = document.getElementById('globalAnnouncementPreview');
		    const editor = document.getElementById('globalAnnouncementEditor');
		    
		    if (!editBtn) return;
		    
		    // 只有 ysc 可以编辑
		    if (currentUser && (currentUser.username === 'ysc' || currentUser.role === 'admin')) {
			    editBtn.classList.remove('hidden');
			}
		    
		    editBtn.addEventListener('click', () => {
		        displayArea.classList.add('hidden');
		        editArea.classList.remove('hidden');
		        editor.value = globalAnnouncementData.content;
		        previewDiv.classList.add('hidden');
		        isGlobalEditing = true;
		    });
		    
		    document.getElementById('cancelGlobalEditBtn').addEventListener('click', () => {
		        displayArea.classList.remove('hidden');
		        editArea.classList.add('hidden');
		        isGlobalEditing = false;
		    });
		    
		    document.getElementById('previewGlobalBtn').addEventListener('click', () => {
		        previewDiv.classList.remove('hidden');
		        previewDiv.innerHTML = marked.parse(editor.value);
		    });
		    
		    // 工具栏按钮
		    const toolbarBtns = document.querySelectorAll('#globalAnnouncementToolbar button');
		    toolbarBtns.forEach(btn => {
		        btn.addEventListener('click', (e) => {
		            e.preventDefault();
		            const cmd = btn.dataset.cmd;
		            const textarea = editor;
		            const start = textarea.selectionStart;
		            const end = textarea.selectionEnd;
		            let insertText = '';
		            switch(cmd) {
		                case 'bold': insertText = `**${textarea.value.substring(start, end)}**`; break;
		                case 'italic': insertText = `*${textarea.value.substring(start, end)}*`; break;
		                case 'heading': insertText = `\n## ${textarea.value.substring(start, end)}\n`; break;
		                case 'link': insertText = `[${textarea.value.substring(start, end) || '链接文字'}](url)`; break;
		                case 'list': insertText = `\n- ${textarea.value.substring(start, end)}`; break;
		                case 'code': insertText = `\`${textarea.value.substring(start, end)}\``; break;
		                default: return;
		            }
		            textarea.setRangeText(insertText, start, end, 'end');
		            textarea.focus();
		        });
		    });
		    
		    document.getElementById('saveGlobalAnnouncementBtn').addEventListener('click', async () => {
		        const newContent = editor.value;
		        try {
		            const res = await fetch('/api/global-announcement', {
		                method: 'POST',
		                headers: { 'Content-Type': 'application/json' },
		                credentials: 'include',
		                body: JSON.stringify({
		                    username: currentUser.username,
		                    content: newContent
		                })
		            });
		            const data = await res.json();
		            if (data.success) {
		                showToast('全局公告已更新');
		                await loadGlobalAnnouncement();
		                displayArea.classList.remove('hidden');
		                editArea.classList.add('hidden');
		                isGlobalEditing = false;
		            } else {
		                showToast(data.msg, 'error');
		            }
		        } catch (err) {
		            showToast('网络错误', 'error');
		        }
		    });
		}
		// ==================== 班级公告编辑 ====================
		function initClassAnnouncementEdit() {
		    const editBtn = document.getElementById('editClassAnnouncementBtn');
		    const previewInput = document.getElementById('settingAnnouncementPreview');
		    if (!editBtn) return;
		    
		    // 初始化预览输入框显示当前公告（纯文本截断）
		    if (classInfo.announcement) {
		        previewInput.value = classInfo.announcement.length > 50 ? classInfo.announcement.substring(0, 50) + '…' : classInfo.announcement;
		    } else {
		        previewInput.value = '';
		    }
		    
		    editBtn.addEventListener('click', () => {
		        const editor = document.getElementById('classAnnouncementEditor');
		        editor.value = classInfo.announcement || '';
		        document.getElementById('classAnnouncementPreview').classList.add('hidden');
		        openModal('classAnnouncementModal');
		    });
		    
		    // 工具栏
		    const toolbar = document.querySelector('#classAnnouncementToolbar');
		    if (toolbar) {
		        toolbar.querySelectorAll('button[data-cmd]').forEach(btn => {
		            btn.addEventListener('click', (e) => {
		                e.preventDefault();
		                const cmd = btn.dataset.cmd;
		                const editor = document.getElementById('classAnnouncementEditor');
		                const start = editor.selectionStart;
		                const end = editor.selectionEnd;
		                let insertText = '';
		                switch(cmd) {
		                    case 'bold': insertText = `**${editor.value.substring(start, end)}**`; break;
		                    case 'italic': insertText = `*${editor.value.substring(start, end)}*`; break;
		                    case 'heading': insertText = `\n## ${editor.value.substring(start, end)}\n`; break;
		                    case 'link': insertText = `[${editor.value.substring(start, end) || '链接文字'}](url)`; break;
		                    case 'list': insertText = `\n- ${editor.value.substring(start, end)}`; break;
		                    case 'code': insertText = `\`${editor.value.substring(start, end)}\``; break;
		                    default: return;
		                }
		                editor.setRangeText(insertText, start, end, 'end');
		                editor.focus();
		            });
		        });
		    }
		    
		    document.getElementById('previewClassBtn').addEventListener('click', () => {
		        const previewDiv = document.getElementById('classAnnouncementPreview');
		        previewDiv.classList.remove('hidden');
		        previewDiv.innerHTML = marked.parse(document.getElementById('classAnnouncementEditor').value);
		    });
		    
		    document.getElementById('saveClassAnnouncementBtn').addEventListener('click', async () => {
		        const newAnnouncement = document.getElementById('classAnnouncementEditor').value;
		        try {
		            const res = await fetch('/api/class-info', {
		                method: 'POST',
		                headers: { 'Content-Type': 'application/json' },
		                credentials: 'include',
		                body: JSON.stringify({
		                    username: currentUser.username,
		                    className: classInfo.className,
		                    announcement: newAnnouncement
		                })
		            });
		            const data = await res.json();
		            if (data.success) {
		                showToast('班级公告已更新');
		                classInfo.announcement = newAnnouncement;
		                // 更新预览输入框
		                const previewInput = document.getElementById('settingAnnouncementPreview');
		                if (previewInput) {
		                    previewInput.value = newAnnouncement.length > 50 ? newAnnouncement.substring(0, 50) + '…' : newAnnouncement;
		                }
		                updateAnnouncement(); // 更新主页公告显示
		                closeAllModals();
		            } else {
		                showToast(data.msg, 'error');
		            }
		        } catch (err) {
		            showToast('网络错误', 'error');
		        }
		    });
		    
		    document.getElementById('cancelClassEditBtn').addEventListener('click', () => {
		        closeAllModals();
		    });
		}
		// ==================== 多学生柱状图滚动 ====================
		function updateMultiStudentChart() {
		    const canvas = document.getElementById('studentChartCanvas');
		    if (!canvas) return;
		
		    // 无数据时清空画布
		    if (students.length === 0) {
		        if (multiStudentChart) {
		            multiStudentChart.destroy();
		            multiStudentChart = null;
		        }
		        const ctx = canvas.getContext('2d');
		        ctx.clearRect(0, 0, canvas.width, canvas.height);
		        ctx.font = '16px sans-serif';
		        ctx.fillStyle = '#9ca3af';
		        ctx.textAlign = 'center';
		        ctx.fillText('暂无学生数据', canvas.width/2, canvas.height/2);
		        return;
		    }
		
		    // 确保窗口大小不超过学生总数（如果学生少于5个，则显示全部）
		    const actualWindowSize = Math.min(multiWindowSize, students.length);
		    // 确保起始索引有效
		    if (multiStartIndex >= students.length) multiStartIndex = 0;
		
		    // 获取当前窗口中的学生（循环取数，保证始终有 actualWindowSize 个）
		    const windowStudents = [];
		    for (let i = 0; i < actualWindowSize; i++) {
		        const index = (multiStartIndex + i) % students.length;
		        windowStudents.push(students[index]);
		    }
		
		    // 准备图表数据
		    const labels = windowStudents.map(s => s.name);
		    const posData = windowStudents.map(s => s.positive_score);
		    const negData = windowStudents.map(s => s.negative_score);
		
		    // 计算Y轴最大值（取所有数据中的最大值，留一点空间）
		    const allScores = [...posData, ...negData];
		    const maxScore = Math.max(...allScores, 10); // 至少10
		
		    const data = {
		        labels: labels,
		        datasets: [
		            {
		                label: '正分',
		                data: posData,
		                backgroundColor: 'rgba(34, 197, 94, 0.7)',
		                borderColor: 'rgb(34, 197, 94)',
		                borderWidth: 1
		            },
		            {
		                label: '负分',
		                data: negData,
		                backgroundColor: 'rgba(239, 68, 68, 0.7)',
		                borderColor: 'rgb(239, 68, 68)',
		                borderWidth: 1
		            }
		        ]
		    };
		
		    const options = {
		        responsive: true,
		        maintainAspectRatio: false,
		        scales: {
		            y: {
		                beginAtZero: true,
		                max: maxScore
		            }
		        },
		        plugins: {
		            legend: { position: 'top' },
		            title: {
		                display: true,
		                text: `学生积分滚动 (显示 ${actualWindowSize} 人)`,
		                font: { size: 14 }
		            }
		        },
		        animation: {
		            duration: 800, // 动画时长，与定时器配合，营造滑动感
		            easing: 'easeOutQuart'
		        }
		    };
		
		    if (multiStudentChart) {
		        multiStudentChart.data = data;
		        multiStudentChart.options = options;
		        multiStudentChart.update();
		    } else {
		        const ctx = canvas.getContext('2d');
		        multiStudentChart = new Chart(ctx, {
		            type: 'bar',
		            data: data,
		            options: options
		        });
		    }
		}
		
		function startMultiStudentChart() {
		    if (multiInterval) clearInterval(multiInterval);
		    if (students.length === 0) return;
		    multiStartIndex = 0;
		    updateMultiStudentChart();
		    multiInterval = setInterval(() => {
		        // 窗口向右移动（即起始索引+1），实现向左滑动效果
		        multiStartIndex = (multiStartIndex + 1) % students.length;
		        updateMultiStudentChart();
		    }, 3000); // 每3秒滚动一次（可根据需要调整）
		}
		
		function stopMultiStudentChart() {
		    if (multiInterval) {
		        clearInterval(multiInterval);
		        multiInterval = null;
		    }
		}
	    // ==================== 学生操作函数 (API版本) ====================
	    async function addStudent() {
	        if (!currentUser) return showToast('请先登录', 'warning');
	        const id = document.getElementById('studentId').value.trim();
	        const name = document.getElementById('studentName').value.trim();
	        const pos = parseInt(document.getElementById('positiveScore').value) || 0;
	        const neg = parseInt(document.getElementById('negativeScore').value) || 0;
	
	        if (!id || !name) {
	            showToast('学号和姓名不能为空', 'error');
	            return;
	        }
	
	        try {
	            const res = await fetch('/api/students', {
	                method: 'POST',
	                headers: { 'Content-Type': 'application/json' },
	                body: JSON.stringify({
	                    username: currentUser.username,
	                    id, name,
	                    positive_score: pos,
	                    negative_score: neg
	                })
	            });
	            const data = await res.json();
	            if (data.success) {
	                showToast('添加成功');
	                closeAllModals();
	                await loadUserData(currentUser.username);
	                refreshAll();
	                addLog('INFO', 'Add Student', `Added ${id} ${name} (${pos},${neg})`);
	            } else {
	                showToast(data.msg, 'error');
	            }
	        } catch (err) {
	            showToast('网络错误', 'error');
	        }
	    }
	
	    async function deleteStudent() {
	        if (!currentUser) return showToast('请先登录', 'warning');
	        const id = document.getElementById('deleteStudentId').value.trim();
	        if (!id) return showToast('请输入学号', 'warning');
	
	        try {
	            const res = await fetch(`/api/students/${id}?username=${currentUser.username}`, {
	                method: 'DELETE'
	            });
	            const data = await res.json();
	            if (data.success) {
	                showToast('删除成功');
	                closeAllModals();
	                await loadUserData(currentUser.username);
	                refreshAll();
	                addLog('WARN', 'Delete Student', `Deleted ${id}`);
	            } else {
	                showToast(data.msg, 'error');
	            }
	        } catch (err) {
	            showToast('网络错误', 'error');
	        }
	    }
	
	    async function adjustScore() {
	        if (!currentUser) return showToast('请先登录', 'warning');
	        const id = document.getElementById('adjustStudentId').value.trim();
	        const posAdj = parseInt(document.getElementById('adjustPositiveScore').value) || 0;
	        const negAdj = parseInt(document.getElementById('adjustNegativeScore').value) || 0;
	
	        if (!id) {
	            showToast('请输入学号', 'warning');
	            return;
	        }
	
	        try {
	            const res = await fetch(`/api/students/${id}/adjust-score`, {
	                method: 'POST',
	                headers: { 'Content-Type': 'application/json' },
	                body: JSON.stringify({
	                    username: currentUser.username,
	                    operation: currentOperation,
	                    positive_adjust: posAdj,
	                    negative_adjust: negAdj
	                })
	            });
	            const data = await res.json();
	            if (data.success) {
	                showToast('调整成功');
	                closeAllModals();
	                await loadUserData(currentUser.username);
	                refreshAll();
	                addLog('INFO', 'Adjust Score', `${id} ${currentOperation} pos:${posAdj} neg:${negAdj}`);
	            } else {
	                showToast(data.msg, 'error');
	            }
	        } catch (err) {
	            showToast('网络错误', 'error');
	        }
	    }
	
